rules_version = '2';

// Firestore security rules for Legend Card Manager.
//
// Access is closed by default. A later change opens a data path by adding an explicit `match` block above
// the catch-all. Each opened path combines isMember() with its own checks and comes with emulator rules tests
// (see "Adding a new data path" in docs/conventions.md).
//
// Only accounts on the DM's access list are members (spec: table-access; design D2 of invite-only-sign-in). Any
// Google account can sign in to Firebase Auth, but without an entry on the list it reads and writes nothing except
// its own entry.
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the request comes from a signed-in account with a verified email address. On its own it grants only
    // reading the account's own access-list entry; every other opened path requires isMember().
    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', null) is string;
    }

    // The signed-in account's email address in lowercase: the ID of its access-list entry. Call it only after
    // hasVerifiedEmail().
    function myEmail() {
      return request.auth.token.email.lower();
    }

    // True when the request comes from an account on the access list: a verified email address whose entry exists.
    // Every opened path must require it. It costs one document access per request (rules cache it within a request).
    //
    // The largest batches call it dozens of times, and a request may evaluate at most 1000 expressions, so the body is
    // kept as short as it can be. It skips hasVerifiedEmail()'s null checks on purpose: without a signed-in user, or
    // without a verified `email` claim, reading the token is an error, and an error denies like false. No rule negates
    // isMember(), which is what would turn that error into a grant. Keep the path in step with allowedEmailPath().
    function isMember() {
      return request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email.lower()));
    }

    // True when the signed-in member is the owner of the document keyed by `uid`. The uid comes first, so another
    // user's document costs no membership check.
    function isSelf(uid) {
      return request.auth.uid == uid && isMember();
    }

    function allowedEmailPath(email) {
      return /databases/$(database)/documents/allowedEmails/$(email);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function cardPath(cardId) {
      return /databases/$(database)/documents/cards/$(cardId);
    }

    function holdingPath(holdingId) {
      return /databases/$(database)/documents/userCards/$(holdingId);
    }

    function partyPath() {
      return /databases/$(database)/documents/party/main;
    }

    function ledgerPath(entryId) {
      return /databases/$(database)/documents/ledger/$(entryId);
    }

    function drawPath(drawId) {
      return /databases/$(database)/documents/draws/$(drawId);
    }

    function drawSessionPath(sessionId) {
      return /databases/$(database)/documents/drawSessions/$(sessionId);
    }

    function tablePath() {
      return /databases/$(database)/documents/table/main;
    }

    function tableChangePath(changeId) {
      return /databases/$(database)/documents/tableChanges/$(changeId);
    }

    function playerWordsPath(uid) {
      return /databases/$(database)/documents/playerWords/$(uid);
    }

    function usePath(useId) {
      return /databases/$(database)/documents/uses/$(useId);
    }

    function definitionChangePath(changeId) {
      return /databases/$(database)/documents/definitionChanges/$(changeId);
    }

    function setPath(setId) {
      return /databases/$(database)/documents/sets/$(setId);
    }

    function characterPath(characterId) {
      return /databases/$(database)/documents/characters/$(characterId);
    }

    function setChangePath(changeId) {
      return /databases/$(database)/documents/setChanges/$(changeId);
    }

    function diceRollPath(rollId) {
      return /databases/$(database)/documents/diceRolls/$(rollId);
    }

    function dmRollPath(rollId) {
      return /databases/$(database)/documents/dmRolls/$(rollId);
    }

    function combatPath() {
      return /databases/$(database)/documents/combat/main;
    }

    function combatantPath(combatantId) {
      return /databases/$(database)/documents/combatants/$(combatantId);
    }

    function dmCombatantPath(combatantId) {
      return /databases/$(database)/documents/dmCombatants/$(combatantId);
    }

    function combatChangePath(changeId) {
      return /databases/$(database)/documents/combatChanges/$(changeId);
    }

    // Definition statuses (spec: definition-editing). A player reads only active and retired definitions; a draft
    // reaches the DM only. Keep in step with src/features/definitions/status.ts.
    function playerVisible(status) {
      return status in ['active', 'retired'];
    }

    // A change record's snapshot that players see: active or retired, with "Listede görünür" on (design D7 of
    // unify-cards-and-true-words). Keep in step with isPublicStep in the definitions schema.
    function visibleSnapshot(snapshot) {
      return snapshot != null && playerVisible(snapshot.status) && snapshot.isInLibrary == true;
    }

    // The behavior flags of a definition (spec: definition-editing, "Behavior flags"; design D2 of
    // unify-cards-and-true-words). Keep in step with BEHAVIOR_FLAGS in src/features/definitions/flags.ts.
    function flagKeys() {
      return ['isInLibrary', 'isInDraws', 'isInSetPacks', 'isInMechanicPacks', 'isRepeatable', 'hasHeldEffect',
        'hasUseEffect', 'isKeptOnUse'];
    }

    // The pack types of one set, whose cards come from "Set paketlerinde çıkar"; the others (Mechanic and Golden) come
    // from "Mechanic paketlerinde çıkar". Keep in step with SET_PACK_TYPES in src/features/packs/catalog.ts.
    function isSetPackType(type) {
      return type in ['standard', 'premium', 'cursed', 'pandemonium', 'pandemoniumCursed'];
    }

    // The status steps a definition may take in one write (design D5): a draft is edited or published, an active
    // definition is edited or retired, a retired one is edited or brought back. Nothing ever becomes a draft again.
    function allowedStatusStep(before, after) {
      return (before == 'draft' && after in ['draft', 'active'])
        || (before == 'active' && after in ['active', 'retired'])
        || (before == 'retired' && after in ['retired', 'active']);
    }

    // The step a change record names for a status pair (null for none: added or deleted). Which pairs are allowed at
    // all is the definition's own rule; this only names them. Keep in step with stepFor in the definitions schema.
    function stepFor(before, after) {
      return before == null ? 'added'
        : after == null ? 'deleted'
        : before == after ? 'edited'
        : before == 'draft' ? 'published'
        : after == 'retired' ? 'retired'
        : 'restored';
    }

    // A string of 1 to `max` characters.
    function textOfSize(value, max) {
      return value is string && value.size() >= 1 && value.size() <= max;
    }

    // An access-list address (design D3 of invite-only-sign-in): at most 254 characters, no capital letters, spaces
    // or "/", exactly one "@", and a dot in the part after it. Keep in step with EMAIL_PATTERN in
    // src/features/access/email.ts and scripts/lib/allowEmail.ts.
    function validEmailId(email) {
      return email.size() <= 254 && email.matches('[^@ /A-Z]+@[^@ /A-Z]+[.][^@ /A-Z]+');
    }

    // A definition's picture (design D3 of upload-card-and-word-pictures): no field (it never had one), null (the DM
    // removed it), or the Cloud Storage path of a picture of this very definition, `<folder>/<id>/<hash>.webp`.
    // Keep in step with src/features/definitions/picturePath.ts and storage.rules.
    function validPicture(data, folder, id) {
      return !('picture' in data)
        || data.picture == null
        || (data.picture is string
          && data.picture.matches(folder + '/' + id + '/[0-9a-f]{10}[.]webp'));
    }

    // A definition with its status and its flags, as a change record keeps it, a card's or a True Word's (CardSnapshot
    // in the definitions schema).
    function cardSnapshot(data) {
      return {
        'kind': data.kind,
        'name': data.name,
        'nameKey': data.nameKey,
        'setCode': data.setCode,
        'cost': data.cost,
        'rarity': data.rarity,
        'mechanicPack': data.mechanicPack,
        'text': data.text,
        'status': data.status,
        'picture': data.get('picture', null),
        'isInLibrary': data.isInLibrary,
        'isInDraws': data.isInDraws,
        'isInSetPacks': data.isInSetPacks,
        'isInMechanicPacks': data.isInMechanicPacks,
        'isRepeatable': data.isRepeatable,
        'hasHeldEffect': data.hasHeldEffect,
        'hasUseEffect': data.hasUseEffect,
        'isKeptOnUse': data.isKeptOnUse
      };
    }

    // The record target of a definition of `kind`: 'word' for a True Word, 'card' for every other kind.
    function targetOf(kind) {
      return kind == 'trueWord' ? 'word' : 'card';
    }

    // The change record `changeId` is created in this same request, for this target. The record's own rule checks that
    // it agrees with the definition before and after (definitionChanges below).
    function recordedBy(changeId, target, targetId) {
      return changeId is string
        && createdNow(definitionChangePath(changeId))
        && getAfter(definitionChangePath(changeId)).data.target == target
        && getAfter(definitionChangePath(changeId)).data.targetId == targetId;
    }

    // The ID of the record that deletes a draft: fixed by the draft's ID and its newest record, so the definition's
    // rule can find it without a query. Keep in step with deleteRecordId in src/features/definitions/api.ts.
    function deleteRecordId(targetId, changeId) {
      return 'del-' + targetId + '-' + changeId;
    }

    // A player's known True Words ({ wordId: holdingId }) and open draft, before and after this request. A player
    // without a `playerWords` document knows nothing and has no open draft.
    function knownBefore(uid) {
      return exists(playerWordsPath(uid)) ? get(playerWordsPath(uid)).data.known : {};
    }

    function knownAfter(uid) {
      return existsAfter(playerWordsPath(uid)) ? getAfter(playerWordsPath(uid)).data.known : {};
    }

    function openDraftBefore(uid) {
      return exists(playerWordsPath(uid)) ? get(playerWordsPath(uid)).data.openDraftId : null;
    }

    function openDraftAfter(uid) {
      return existsAfter(playerWordsPath(uid)) ? getAfter(playerWordsPath(uid)).data.openDraftId : null;
    }

    // The open pack's ID before and after this request: null while no pack is open, or before the table exists.
    function openPackBefore() {
      return exists(tablePath()) ? get(tablePath()).data.openPackId : null;
    }

    function openPackAfter() {
      return existsAfter(tablePath()) ? getAfter(tablePath()).data.openPackId : null;
    }

    // No pack is open, before or after this request. While a pack is open, the whole table waits for it: every card
    // movement, draw and balance change other than the pack's own steps requires this.
    function tableFree() {
      return openPackBefore() == null && openPackAfter() == null;
    }

    // A document that this same request creates: it did not exist before, and it does after.
    function createdNow(path) {
      return !exists(path) && existsAfter(path);
    }

    // A balance write is explained by a ledger entry that this same request creates: the entry is for this
    // currency and account, its balance after is the new balance, and its change is the difference.
    function setByNewEntry(entryId, currency, account, before, after) {
      let entry = getAfter(ledgerPath(entryId)).data;
      return entryId is string
        && !exists(ledgerPath(entryId))
        && existsAfter(ledgerPath(entryId))
        && entry.currency == currency
        && entry.account == account
        && entry.balanceAfter == after
        && entry.delta == after - before;
    }

    // What a player may pay to use a card or a True Word at its cost as written (spec: card-holdings, "The price of
    // a use"; design D3 of pay-lp-on-use): a cost of whole digits exactly that, no cost nothing, "d6" a die of 1 to 6,
    // and anything else ("X", "X+1", "-1") any whole amount from 0. Keep in step with priceOfUse and priceAllows in
    // src/features/cards/display.ts.
    function priceAllows(cost, amount) {
      let value = cost == null ? '' : cost.trim();
      return amount is int
        && amount >= 0
        && amount <= 1000000
        && (value == '' ? amount == 0
          : value.matches('[0-9]+') ? amount == int(value)
          : value.lower() == 'd6' ? amount >= 1 && amount <= 6
          : true);
    }

    // An initiative modifier: a whole number from -10 to +30 (spec: initiative-tracker, "The initiative modifier").
    // Keep in step with CHARACTER_LIMITS and COMBAT_LIMITS.
    function validInitiativeModifier(value) {
      return value is int && value >= -10 && value <= 30;
    }

    // True when the signed-in user's profile says DM. Reads the profile once per request (cached after that).
    function isDm() {
      return isMember()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'dm';
    }

    // A use on a stored character (design D7 of add-characters, D4 of add-character-effects): no character (the field
    // missing, as from the previous app, or null), or an existing, unarchived character whose name the use keeps in
    // `usedOn`. Used by uses that close their holding (userCards) and kept uses (uses).
    function usedCharacterMatches(next) {
      let characterId = next.get('usedOnCharacterId', null);
      return characterId == null
        || (characterId is string
          && exists(characterPath(characterId))
          && get(characterPath(characterId)).data.archived == false
          && get(characterPath(characterId)).data.name == next.get('usedOn', null));
    }

    // True when an update changes no field outside `keys`.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // A card's holder before and after the request. A card without the field has none: null.
    function holderBefore(cardId) {
      return get(cardPath(cardId)).data.get('holder', null);
    }

    function holderAfter(cardId) {
      return getAfter(cardPath(cardId)).data.get('holder', null);
    }

    // A profile name: 1 to 100 characters, or null when the Google account has none (DISPLAY_NAME_MAX).
    function validName(value) {
      return value == null || (value is string && value.size() >= 1 && value.size() <= 100);
    }

    // A profile picture URL: at most 2048 characters, or null (PHOTO_URL_MAX).
    function validPhoto(value) {
      return value == null || (value is string && value.size() <= 2048);
    }

    // The access list (spec: table-access; design D3 of invite-only-sign-in): one entry per Google email address that
    // may use the app, keyed by the address in lowercase, with the time it was added and, after the person's first
    // entry, their uid. Only the DM lists, adds and removes entries, and never removes their own. Any account with a
    // verified address reads its own entry, whether or not it exists: the "ekli değil" screen follows it. A member
    // links their own unlinked entry to their own uid, once. Nothing else ever changes an entry, the DM included.
    match /allowedEmails/{email} {
      allow get: if (hasVerifiedEmail() && email == myEmail()) || isDm();
      allow list: if isDm();
      allow create: if isDm()
        && validEmailId(email)
        && request.resource.data.keys().hasOnly(['addedAt'])
        && request.resource.data.keys().hasAll(['addedAt'])
        && request.resource.data.addedAt == request.time;
      allow update: if isMember()
        && email == myEmail()
        && resource.data.get('uid', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isDm() && email != myEmail();
    }

    // User profiles. Everyone signed in reads every profile. A user creates only their own, only as a player,
    // and later changes only its name, its picture and its dice style. Roles are changed by the admin script (Admin SDK), never here.
    // The other writes are a player's Legend Points, each together with the ledger entry that records it: the DM
    // changes them by hand, a player lowers their own by hand (never raises them), a player pays 1 LP for their own
    // draw, a pack's or a True Word draft's payment or refund moves them, and the player or the DM pays for using the
    // player's card or True Word (a use that closes its holding, `use`, or one that keeps it in the hand, `keptUse`).
    match /users/{uid} {
      allow read: if isMember();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'photoURL', 'role', 'createdAt'])
        && request.resource.data.role == 'player'
        && request.resource.data.createdAt == request.time
        && validName(request.resource.data.displayName)
        && validPhoto(request.resource.data.photoURL);
      allow update: if (
          isSelf(uid)
          && onlyChanges(['displayName', 'photoURL'])
          && validName(request.resource.data.displayName)
          && validPhoto(request.resource.data.photoURL)
        )
        || (
          isSelf(uid)
          && onlyChanges(['diceStyle'])
          && request.resource.data.diceStyle in diceStyles()
        )
        || (lpSetByEntry('manual')
          && (isDm() || (isSelf(uid) && request.resource.data.lp < resource.data.get('lp', 0))))
        || (isSelf(uid) && lpSetByEntry('draw'))
        || (lpSetByEntry('pack') && (isSelf(uid) || isDm()))
        || (lpSetByEntry('wordDraft') && (isSelf(uid) || isDm()))
        || (lpSetByEntry('use') && (isSelf(uid) || isDm()))
        || (lpSetByEntry('keptUse') && (isSelf(uid) || isDm()));
      allow delete: if false;

      // A player's LP (a whole number, never below 0) set with a new ledger entry from `source`: a change by hand
      // (the DM's, or the player's own lowering), the player's draw payment, whose amount the ledger rules fix at 1, a
      // pack's or a True Word draft's payment or refund, or a use's payment, which the ledger rules tie to its record.
      // A missing `lp` is 0.
      //
      // The entry's source comes first: it tells the update rule's branches apart cheaply, so a use's payment, the
      // last branch, does not evaluate the whole check of every branch before it. A request may evaluate at most 1000
      // expressions (design of invite-only-sign-in).
      function lpSetByEntry(source) {
        let next = request.resource.data;
        let entryId = next.get('lpEntryId', null);
        return entryId is string
          && existsAfter(ledgerPath(entryId))
          && getAfter(ledgerPath(entryId)).data.source == source
          && isMember()
          && onlyChanges(['lp', 'lpEntryId'])
          && resource.data.role == 'player'
          && next.get('lp', null) is int
          && next.lp >= 0
          && setByNewEntry(entryId, 'lp', uid, resource.data.get('lp', 0), next.lp);
      }
    }

    // The party purse: the group's shared GP. Everyone signed in reads it. Only the DM writes it, and only together
    // with the ledger entry that records the change: by hand, or a pack's GP payment or refund. A missing purse holds
    // 0 GP.
    match /party/main {
      allow read: if isMember();
      allow create: if gpSetByEntry(0);
      allow update: if gpSetByEntry(resource.data.gp);
      allow delete: if false;

      function gpSetByEntry(before) {
        let next = request.resource.data;
        return isMember()
          && next.keys().hasOnly(['gp', 'gpEntryId'])
          && next.keys().hasAll(['gp', 'gpEntryId'])
          && next.gp is int
          && next.gp >= 0
          && setByNewEntry(next.gpEntryId, 'gp', 'party', before, next.gp)
          && isDm();
      }
    }

    // The ledger: one entry per balance change, created together with the balance it sets, and never changed or
    // deleted. Everyone signed in reads it. The DM makes changes by hand, and a player lowers their own LP by hand; a
    // player pays for their own draw; a pack's
    // or a True Word draft's start pays for it and the DM's cancel refunds it; a use pays for it, whether it closes
    // its holding or keeps the card or word in the hand. Only a pack's own steps may change a balance while the pack
    // is open.
    match /ledger/{entryId} {
      allow read: if isMember();
      allow create: if validLedgerEntry()
        && (((manualChange() || paysForDraw() || forWordDraft() || forUse() || forKeptUse()) && tableFree())
          || forPack());
      allow update, delete: if false;

      // Exactly the stored fields. Limits: keep in step with BALANCE_LIMITS in src/features/balances/schema.ts.
      function validLedgerEntry() {
        let data = request.resource.data;
        let fields = ['currency', 'account', 'delta', 'balanceAfter', 'source', 'reason', 'drawId', 'by',
          'at'];
        return isMember()
          && data.keys().hasOnly(fields)
          && data.keys().hasAll(fields)
          && data.account is string
          && data.delta is int
          && data.delta != 0
          && data.delta >= -1000000
          && data.delta <= 1000000
          && data.balanceAfter is int
          && data.balanceAfter >= 0
          && data.by == request.auth.uid
          && data.at == request.time;
      }

      // A change by hand, with a reason: the DM's, of a player's LP or the party's GP, or a player's own, which only
      // lowers their own LP (the owner's trust in players, design D2 of player-discard-and-spend).
      function manualChange() {
        let data = request.resource.data;
        return data.source == 'manual'
          && data.drawId == null
          && data.reason is string
          && data.reason.size() >= 1
          && data.reason.size() <= 200
          && data.reason.trim().size() >= 1
          && ((isDm() && (setsLp() || setsGp()))
            || (data.currency == 'lp'
              && data.account == request.auth.uid
              && data.delta < 0
              && setsLp()));
      }

      // A player's payment of 1 LP for their own draw, which this same request creates and which names this entry.
      // It has no reason: the draw explains it.
      function paysForDraw() {
        let data = request.resource.data;
        return data.source == 'draw'
          && data.reason == null
          && data.currency == 'lp'
          && data.account == request.auth.uid
          && data.delta == -1
          && data.drawId is string
          && createdNow(drawPath(data.drawId))
          && getAfter(drawPath(data.drawId)).data.entryId == entryId
          && setsLp();
      }

      // A pack's payment, created with the opening that names it, or its refund, created with the DM's cancel that
      // names it. Neither has a reason: the pack explains it. The pack's rules decide who may pay or refund what.
      function forPack() {
        let data = request.resource.data;
        return data.source == 'pack'
          && data.reason == null
          && data.drawId is string
          && (paysForPackOpening() || refundsPack())
          && (setsLp() || setsGp());
      }

      // The opening that this same request creates names this entry, and the entry takes exactly its cost from the
      // account it was paid from.
      function paysForPackOpening() {
        let data = request.resource.data;
        let pack = getAfter(drawPath(data.drawId)).data;
        return createdNow(drawPath(data.drawId))
          && pack.kind == 'pack'
          && pack.entryId == entryId
          && data.delta == -pack.cost
          && matchesPackPayment(pack);
      }

      // The open pack that this same request cancels names this entry as its refund, and the entry returns exactly
      // its cost to the account it was paid from.
      function refundsPack() {
        let data = request.resource.data;
        let before = get(drawPath(data.drawId)).data;
        let after = getAfter(drawPath(data.drawId)).data;
        return before.kind == 'pack'
          && before.status == 'open'
          && after.status == 'cancelled'
          && after.refundEntryId == entryId
          && data.delta == before.cost
          && matchesPackPayment(before);
      }

      // A True Word draft's payment, created with the draft that names it, or its refund, created with the DM's
      // cancel that names it. Always the draft's player's LP, without a reason. The draft's rules decide who may pay
      // or refund what.
      function forWordDraft() {
        let data = request.resource.data;
        return data.source == 'wordDraft'
          && data.reason == null
          && data.currency == 'lp'
          && data.drawId is string
          && (paysForWordDraft() || refundsWordDraft())
          && setsLp();
      }

      // The draft that this same request creates names this entry, which takes exactly its cost from its player.
      function paysForWordDraft() {
        let data = request.resource.data;
        let draft = getAfter(drawPath(data.drawId)).data;
        return createdNow(drawPath(data.drawId))
          && draft.kind == 'wordDraft'
          && draft.paidWith == 'lp'
          && draft.entryId == entryId
          && data.account == draft.uid
          && data.delta == -draft.cost;
      }

      // The open paid draft that this same request cancels names this entry as its refund, which returns exactly
      // its cost to its player.
      function refundsWordDraft() {
        let data = request.resource.data;
        let before = get(drawPath(data.drawId)).data;
        let after = getAfter(drawPath(data.drawId)).data;
        return before.kind == 'wordDraft'
          && before.status == 'open'
          && before.paidWith == 'lp'
          && after.status == 'cancelled'
          && after.refundEntryId == entryId
          && data.account == before.uid
          && data.delta == before.cost;
      }

      // A card use's payment, created with the holding's close as used that names it (design D4 of pay-lp-on-use).
      // Always the holder's LP, without a reason: the holding explains it. The holding's rules decide who may use the
      // card and for how much.
      function forUse() {
        let data = request.resource.data;
        return data.source == 'use'
          && data.reason == null
          && data.currency == 'lp'
          && data.drawId is string
          && paysForUse()
          && setsLp();
      }

      // The open holding that this same request closes as used names this entry, which takes exactly its payment
      // from its holder.
      function paysForUse() {
        let data = request.resource.data;
        let before = get(holdingPath(data.drawId)).data;
        let after = getAfter(holdingPath(data.drawId)).data;
        return before.returnedAt == null
          && after.returnReason == 'used'
          && after.get('useEntryId', null) == entryId
          && after.get('useCost', null) == -data.delta
          && data.account == before.uid;
      }

      // A kept use's payment (design D5 of unify-cards-and-true-words): a use of a card or True Word that stays in the
      // hand, created with the use record that names it. Always its player's LP, without a reason. The use's rules
      // decide who may use it and for how much.
      function forKeptUse() {
        let data = request.resource.data;
        return data.source == 'keptUse'
          && data.reason == null
          && data.currency == 'lp'
          && data.drawId is string
          && paysForKeptUse()
          && setsLp();
      }

      // The use that this same request creates names this entry, which takes exactly its cost from its player.
      function paysForKeptUse() {
        let data = request.resource.data;
        let use = getAfter(usePath(data.drawId)).data;
        return createdNow(usePath(data.drawId))
          && use.entryId == entryId
          && data.account == use.uid
          && data.delta == -use.cost;
      }

      // The entry's currency and account are the ones the pack was paid with: the hand's owner's LP, or the party's GP.
      function matchesPackPayment(pack) {
        let data = request.resource.data;
        return (pack.paidWith == 'lp' && data.currency == 'lp' && data.account == pack.uid)
          || (pack.paidWith == 'gp' && data.currency == 'gp' && data.account == 'party');
      }

      // A player's LP: the profile now points at this entry and holds its balance, which follows from the balance
      // before (missing: 0) and the change.
      function setsLp() {
        let data = request.resource.data;
        let profile = userPath(data.account);
        return data.currency == 'lp'
          && exists(profile)
          && get(profile).data.role == 'player'
          && getAfter(profile).data.get('lpEntryId', null) == entryId
          && getAfter(profile).data.get('lp', null) == data.balanceAfter
          && get(profile).data.get('lp', 0) + data.delta == data.balanceAfter;
      }

      // The party's GP: the purse now points at this entry and holds its balance. A purse created by this request
      // held 0 before.
      function setsGp() {
        let data = request.resource.data;
        return data.currency == 'gp'
          && data.account == 'party'
          && existsAfter(partyPath())
          && getAfter(partyPath()).data.gpEntryId == entryId
          && getAfter(partyPath()).data.gp == data.balanceAfter
          && (exists(partyPath()) ? get(partyPath()).data.gp : 0) + data.delta == data.balanceAfter;
      }
    }

    // Definitions: cards and True Words (design D1 of unify-cards-and-true-words). Everyone signed in reads the active
    // and retired ones; only the DM reads a draft. The import scripts (Admin SDK) add them. The DM adds, edits,
    // publishes, retires, brings back and deletes them, each step together with its change record (definitionChanges
    // below). Otherwise the application changes only the `holder` of a card with one copy, together with the holding
    // that explains it (see userCards below), and never in the same write as the definition.
    match /cards/{cardId} {
      allow read: if isMember() && (playerVisible(resource.data.status) || isDm());
      allow create: if isMember() && addedByDm();
      allow update: if isMember()
        && ((onlyChanges(['holder'])
            && resource.data.isRepeatable == false
            && (takenFromPool() || releasedByClosedHolding() || movedByTransfer()))
          || changedByDm());
      allow delete: if isMember()
        && resource.data.status == 'draft'
        && deletionRecorded()
        && tableFree()
        && isDm();

      // The definition fields with the behavior flags, and the record that explains their newest change.
      function definitionKeys() {
        return ['kind', 'name', 'nameKey', 'setCode', 'cost', 'rarity', 'mechanicPack', 'text', 'status', 'changeId']
          .concat(flagKeys());
      }

      // Every flag is a boolean, and the kind's fixed ones have their value (spec: definition-editing, "Flags fixed by
      // the kind"): a Cursed card and a True Word are in no pack's own cards, and a True Word is repeatable and kept
      // on use. Keep in step with FIXED_FLAGS in src/features/definitions/flags.ts.
      function validFlags(data) {
        return data.isInLibrary is bool
          && data.isInDraws is bool
          && data.isInSetPacks is bool
          && data.isInMechanicPacks is bool
          && data.isRepeatable is bool
          && data.hasHeldEffect is bool
          && data.hasUseEffect is bool
          && data.isKeptOnUse is bool
          && (!(data.kind in ['cursed', 'trueWord'])
            || (data.isInSetPacks == false && data.isInMechanicPacks == false))
          && (data.kind != 'trueWord' || (data.isRepeatable == true && data.isKeptOnUse == true));
      }

      // A definition's shape: the limits of CARD_LIMITS, a status, the fields its kind has, its picture, and its flags.
      // A normal draft may still lack its set, rarity and mechanic pack; completeCard decides when it may be active.
      // Only a card with one copy (`isRepeatable` off) has a holder.
      function validCard(data) {
        return textOfSize(data.name, 200)
          && validPicture(data, data.kind == 'trueWord' ? 'words' : 'cards', cardId)
          && textOfSize(data.nameKey, 200)
          && (data.cost == null || textOfSize(data.cost, 10))
          && data.text is string
          && data.text.size() <= 2000
          && data.status in ['draft', 'active', 'retired']
          && validFlags(data)
          && (data.isRepeatable == false || data.get('holder', null) == null)
          && (
            (data.kind == 'normal'
              && (data.setCode == null || textOfSize(data.setCode, 100))
              && (data.rarity == null || data.rarity in ['common', 'rare'])
              && (data.mechanicPack == null || textOfSize(data.mechanicPack, 100)))
            || (data.kind == 'blessed'
              && data.setCode == null
              && data.rarity == null
              && (data.mechanicPack == null || textOfSize(data.mechanicPack, 100)))
            || (data.kind in ['cursed', 'trueWord']
              && data.setCode == null
              && data.rarity == null
              && data.mechanicPack == null)
          );
      }

      // Every field the kind requires has a value (spec: definition-editing, "Complete definitions"): a normal card a
      // set, a rarity, a mechanic pack and a text; a Blessed card a mechanic pack and a text; a Cursed card a text; a
      // True Word a cost and a text. Keep in step with missingCardFields and missingWordFields in the cards schema.
      function completeCard(data) {
        return data.text != ''
          && (data.kind == 'trueWord'
            ? data.cost != null
            : (data.kind == 'cursed' || data.mechanicPack != null)
              && (data.kind != 'normal' || (data.setCode != null && data.rarity != null)));
      }

      // The ID's deck matches the kind: `legend-` for normal and Blessed cards, `cursed-` for Cursed cards, `tw-` for
      // True Words.
      function inDeck(kind) {
        return kind == 'cursed' ? cardId.matches('cursed-.+')
          : kind == 'trueWord' ? cardId.matches('tw-.+')
          : cardId.matches('legend-.+');
      }

      // The DM adds a definition as a draft, or straight to active when it is complete and the table is free. It
      // starts in the pool, without a holder.
      function addedByDm() {
        let data = request.resource.data;
        return data.keys().hasOnly(definitionKeys().concat(['holder', 'picture']))
          && data.keys().hasAll(definitionKeys())
          && validCard(data)
          && inDeck(data.kind)
          && data.get('holder', null) == null
          && (data.status == 'draft' || (data.status == 'active' && completeCard(data) && tableFree()))
          && recordedBy(data.changeId, targetOf(data.kind), cardId)
          && isDm();
      }

      // The flags whose change moves cards in or out of the pool stay as they were. Keep in step with POOL_FLAGS in
      // src/features/definitions/flags.ts.
      function samePoolFlags(before, after) {
        return before.isInDraws == after.isInDraws
          && before.isInSetPacks == after.isInSetPacks
          && before.isInMechanicPacks == after.isInMechanicPacks
          && before.isRepeatable == after.isRepeatable;
      }

      // The DM's definition step on a stored definition (design D5, D6, D8 of add-card-and-word-editing; D4, D7 of
      // unify-cards-and-true-words): an allowed status step that leaves an active or retired definition complete, a
      // kind that changes only on a draft (also as it is published) and only between normal and Blessed, retiring and
      // bringing back that change nothing but the status, a free table for every status change and every change of a
      // pool flag, and the step's new record. The holder never changes here, so a card with a holder cannot become
      // repeatable (validCard). The picture and the flags change with the other fields, never with retiring or
      // bringing back.
      function changedByDm() {
        let before = resource.data;
        let after = request.resource.data;
        return onlyChanges(definitionKeys().concat(['picture']))
          && validCard(after)
          && inDeck(after.kind)
          && allowedStatusStep(before.status, after.status)
          && (after.status == 'draft' || completeCard(after))
          && (after.kind == before.kind
            || (before.status == 'draft'
              && before.kind in ['normal', 'blessed'] && after.kind in ['normal', 'blessed']))
          && (before.status == after.status || before.status == 'draft' || onlyChanges(['status', 'changeId']))
          && ((before.status == after.status && samePoolFlags(before, after)) || tableFree())
          && after.changeId != before.get('changeId', null)
          && recordedBy(after.changeId, targetOf(after.kind), cardId)
          && isDm();
      }

      // A draft is deleted together with its record, whose ID the draft's newest record fixes.
      function deletionRecorded() {
        let changeId = resource.data.get('changeId', null);
        return changeId is string
          && recordedBy(deleteRecordId(cardId, changeId), targetOf(resource.data.kind), cardId);
      }

      function holderNow() {
        return resource.data.get('holder', null);
      }

      function holderNext() {
        return request.resource.data.get('holder', null);
      }

      // The holder points at an open holding of this card for the holder's user, after the request.
      function pointsAtOpenHolding(holder) {
        let holding = getAfter(holdingPath(holder.userCardId)).data;
        return holding.cardId == cardId
          && holding.returnedAt == null
          && holder == {'uid': holding.uid, 'userCardId': holder.userCardId};
      }

      // From the pool into a hand: the holding is created in this same request.
      function takenFromPool() {
        let next = holderNext();
        return holderNow() == null
          && next != null
          && next.userCardId is string
          && !exists(holdingPath(next.userCardId))
          && existsAfter(holdingPath(next.userCardId))
          && pointsAtOpenHolding(next);
      }

      // Back to the pool: the holding the holder pointed at is closed as used or discarded.
      function releasedByClosedHolding() {
        let now = holderNow();
        return now != null
          && holderNext() == null
          && getAfter(holdingPath(now.userCardId)).data.returnReason in ['used', 'discarded'];
      }

      // Moved by a transfer: the old holding is closed as transferred to the new holder's holding.
      function movedByTransfer() {
        let now = holderNow();
        let next = holderNext();
        return now != null
          && next != null
          && next.userCardId is string
          && getAfter(holdingPath(now.userCardId)).data.returnReason == 'transferred'
          && getAfter(holdingPath(now.userCardId)).data.transferredTo == next.userCardId
          && pointsAtOpenHolding(next);
      }
    }

    // Holdings: one card's or True Word's stay with one player (design D5 of unify-cards-and-true-words). Everyone
    // signed in reads every holding, open or closed. Only the DM gives and transfers cards and teaches words. A player
    // opens a holding only for their own draw, a choice from their own open pack, or a word learned from their own
    // draft (see draws below). The holder or the DM uses or discards a card; a player never touches another player's
    // card. While a pack is open, nothing is given, learned, used, discarded, taken back or transferred. A use that
    // closes the holding pays its price with its ledger entry and the holder's new LP in the same request; a card or
    // word kept on use is used through `uses` instead. A holding is closed, never deleted, and a closed holding never
    // changes again. Every movement keeps the `holder` of a card with one copy in step with its holdings, checked with
    // getAfter. A True Word's holding is never used, transferred or discarded as a card, and never by its holder: the
    // DM's take-back closes it as discarded together with the player's `playerWords`.
    match /userCards/{holdingId} {
      allow read: if isMember();
      allow create: if isMember() && validNewHolding();
      allow update: if isMember()
        && resource.data.returnedAt == null
        && (
          (onlyChanges(['note']) && validNote(request.resource.data.note) && (isDm() || isHolder()))
          || (onlyChanges(['active']) && request.resource.data.active is bool && isDm()
            && get(cardPath(resource.data.cardId)).data.hasHeldEffect == true)
          || (onlyChanges(['costOverride']) && validCost(request.resource.data.costOverride) && isDm())
          || (closesAsUsed() && (isDm() || isHolder()) && releasesCard() && tableFree())
          || (closesAs('discarded') && request.resource.data.usedOn == null
              && (isDm() || (isHolder() && resource.data.cardKind != 'trueWord'))
              && releasesCard() && tableFree()
              && (resource.data.cardKind != 'trueWord' || takenBack()))
          || (closesAsTransferred() && resource.data.cardKind != 'trueWord'
              && isDm() && movesCard() && tableFree())
        );
      allow delete: if false;

      // Field limits. Keep in step with HOLDING_LIMITS in src/features/hands/schema.ts.
      function validNote(value) {
        return value is string && value.size() <= 1000;
      }

      function validCost(value) {
        return value == null || (value is string && value.size() >= 1 && value.size() <= 10);
      }

      function validUsedOn(value) {
        return value == null || (value is string && value.size() >= 1 && value.size() <= 100);
      }

      function isHolder() {
        return request.auth.uid == resource.data.uid;
      }

      // A new, open holding with exactly the stored fields, given now by the signed-in user to someone with a
      // profile, for an existing definition of the same kind: a DM give, a DM transfer, a draw, a pack's choice, a
      // word learned from a draft, or a word the DM teaches. Every way but a transfer starts the holding active
      // exactly when the definition's "Elde etkili" is on (design D6 of unify-cards-and-true-words); a transfer keeps
      // the active state.
      function validNewHolding() {
        let data = request.resource.data;
        let card = get(cardPath(data.cardId)).data;
        let fields = ['cardId', 'cardName', 'cardKind', 'uid', 'givenAt', 'givenBy', 'givenVia',
          'transferredFrom', 'drawId', 'active', 'note', 'costOverride', 'returnedAt', 'returnedBy',
          'returnReason', 'usedOn', 'transferredTo'];
        return data.keys().hasOnly(fields)
          && data.keys().hasAll(fields)
          && data.cardId is string
          && data.cardName is string && data.cardName.size() >= 1 && data.cardName.size() <= 200
          && data.uid is string
          && data.givenAt == request.time
          && data.givenBy == request.auth.uid
          && data.active is bool
          && validNote(data.note)
          && validCost(data.costOverride)
          && data.returnedAt == null
          && data.returnedBy == null
          && data.returnReason == null
          && data.usedOn == null
          && data.transferredTo == null
          && exists(userPath(data.uid))
          && exists(cardPath(data.cardId))
          && card.kind == data.cardKind
          && (data.givenVia == 'transfer' || data.active == card.hasHeldEffect)
          && (
            (data.givenVia == 'dm' && data.transferredFrom == null && data.drawId == null
              && isDm() && tableFree()
              && (data.cardKind == 'trueWord' ? taughtByDm() : givenByDm()))
            || (data.givenVia == 'transfer' && data.transferredFrom is string && data.drawId == null
              && data.cardKind != 'trueWord' && continuesTransfer() && isDm() && tableFree())
            || (data.givenVia == 'draw' && data.transferredFrom == null && data.drawId is string
              && drawnInto() && tableFree())
            || (data.givenVia == 'pack' && data.transferredFrom == null && data.drawId is string
              && chosenFromPack())
            || (data.givenVia == 'draft' && data.transferredFrom == null && data.drawId is string
              && data.cardKind == 'trueWord' && learnedFromDraft() && tableFree())
          );
      }

      // The holder after this request, for a holding that takes a card from the pool: a card with one copy gets this
      // holding as its holder, and a repeatable card keeps none.
      function takesFromPool(cardId, uid) {
        return get(cardPath(cardId)).data.isRepeatable == true
          ? holderAfter(cardId) == null
          : holderBefore(cardId) == null && holderAfter(cardId) == {'uid': uid, 'userCardId': holdingId};
      }

      // A DM give of an active card, never a draft or a retired one, whatever its flags. A card with one copy in the
      // pool gets this holding as its holder. A held one is an extra copy and keeps its holder.
      function givenByDm() {
        let cardId = request.resource.data.cardId;
        let before = holderBefore(cardId);
        return get(cardPath(cardId)).data.status == 'active'
          && (before == null
            ? takesFromPool(cardId, request.resource.data.uid)
            : holderAfter(cardId) == before);
      }

      // A transfer continues a holding of the same card that this request closes as transferred to this one.
      // The holder moves with it when it pointed at the old holding.
      function continuesTransfer() {
        let data = request.resource.data;
        let previous = getAfter(holdingPath(data.transferredFrom)).data;
        let before = holderBefore(data.cardId);
        return previous.cardId == data.cardId
          && previous.returnReason == 'transferred'
          && previous.transferredTo == holdingId
          && (before != null && before.userCardId == data.transferredFrom
            ? holderAfter(data.cardId) == {'uid': data.uid, 'userCardId': holdingId}
            : holderAfter(data.cardId) == before);
      }

      // A draw that this same request creates opened this holding: the draw names it, this hand, this card and its
      // kind (the draw's own rule checks that the signed-in user drew, and that the kind fits the draw). The card is
      // active and in its draw (spec: card-draws): "Kart çekmede çıkar" for a random draw, "Cursed Deck'te çıkar" for a
      // Cursed draw. A card with one copy comes from the pool and gets this holding as its holder, so a draw never
      // makes an extra copy.
      function drawnInto() {
        let data = request.resource.data;
        let draw = getAfter(drawPath(data.drawId)).data;
        let card = get(cardPath(data.cardId)).data;
        return createdNow(drawPath(data.drawId))
          && draw.holdingId == holdingId
          && draw.uid == data.uid
          && draw.cardId == data.cardId
          && draw.cardName == data.cardName
          && draw.cardKind == data.cardKind
          && data.note == ''
          && data.costOverride == null
          && card.status == 'active'
          && card.isInDraws == true
          && takesFromPool(data.cardId, data.uid);
      }

      // An open pack that this same request marks as chosen names this holding: as its chosen card, which must be in
      // the pack's channel (spec: pack-shop, "Packs follow the pack flags"), or as its mandatory Cursed card, which
      // must be in the Cursed Deck. The pack's own rule checks who chooses. A card with one copy comes from the pool
      // and gets this holding as its holder.
      function chosenFromPack() {
        let data = request.resource.data;
        let before = get(drawPath(data.drawId)).data;
        let after = getAfter(drawPath(data.drawId)).data;
        let card = get(cardPath(data.cardId)).data;
        return before.kind == 'pack'
          && before.status == 'open'
          && after.status == 'chosen'
          && after.uid == data.uid
          && ((after.chosen.holdingId == holdingId
              && after.chosen.cardId == data.cardId
              && after.chosen.cardName == data.cardName
              && after.chosen.cardKind == data.cardKind
              && (isSetPackType(before.packType) ? card.isInSetPacks : card.isInMechanicPacks) == true)
            || (after.cursed != null
              && after.cursed.holdingId == holdingId
              && after.cursed.cardId == data.cardId
              && after.cursed.cardName == data.cardName
              && data.cardKind == 'cursed'
              && card.isInDraws == true))
          && data.note == ''
          && data.costOverride == null
          && card.status == 'active'
          && takesFromPool(data.cardId, data.uid);
      }

      // A word learned from the player's open draft, which this same request closes as learned with this holding
      // (the draft's own rule checks that the word was shown). The word is active, and the player did not know it
      // before and knows it with this holding after: never the same word twice.
      function learnedFromDraft() {
        let data = request.resource.data;
        let draft = getAfter(drawPath(data.drawId)).data;
        return get(drawPath(data.drawId)).data.kind == 'wordDraft'
          && get(drawPath(data.drawId)).data.status == 'open'
          && draft.status == 'learned'
          && draft.uid == data.uid
          && draft.learned.holdingId == holdingId
          && learnsWord(data);
      }

      // A word the DM teaches, without a draft, whatever its flags.
      function taughtByDm() {
        return learnsWord(request.resource.data);
      }

      // The player learns an active word they did not know, and knows it with this holding after this request. A word
      // starts without a note or a cost.
      function learnsWord(data) {
        return data.note == ''
          && data.costOverride == null
          && get(cardPath(data.cardId)).data.status == 'active'
          && data.cardName == get(cardPath(data.cardId)).data.name
          && !(data.cardId in knownBefore(data.uid))
          && knownAfter(data.uid)[data.cardId] == holdingId;
      }

      // The DM takes a word back: the word leaves the player's known words in this same request.
      function takenBack() {
        return !(resource.data.cardId in knownAfter(resource.data.uid));
      }

      // Closes the holding now as used, with its payment (design D5 of pay-lp-on-use): the LP paid, and the ledger
      // entry created in this same request when it is more than 0. The DM charges any whole amount; the holder pays
      // the price of the card's cost in this hand. The ledger's balance check keeps it within the holder's LP. A card
      // or word kept on use is never closed as used: its uses are records of their own (uses below).
      function closesAsUsed() {
        let next = request.resource.data;
        return onlyChanges(['returnedAt', 'returnedBy', 'returnReason', 'usedOn', 'useCost', 'useEntryId',
            'usedOnCharacterId'])
          && get(cardPath(resource.data.cardId)).data.isKeptOnUse == false
          && next.keys().hasAll(['useCost', 'useEntryId'])
          && next.returnedAt == request.time
          && next.returnedBy == request.auth.uid
          && next.returnReason == 'used'
          && validUsedOn(next.usedOn)
          && usedCharacterMatches(next)
          && next.useCost is int
          && next.useCost >= 0
          && next.useCost <= 1000000
          && (isDm() || priceAllows(handCost(), next.useCost))
          && (next.useCost == 0
            ? next.useEntryId == null
            : next.useEntryId is string && paidByUseEntry(next.useEntryId, next.useCost));
      }

      // The card's cost in this hand: the DM's override, or the card's own cost (missing: none).
      function handCost() {
        return resource.data.costOverride != null
          ? resource.data.costOverride
          : get(cardPath(resource.data.cardId)).data.get('cost', null);
      }

      // A ledger entry created in this same request pays `cost` for using this holding.
      function paidByUseEntry(entryId, cost) {
        let entry = getAfter(ledgerPath(entryId)).data;
        return createdNow(ledgerPath(entryId))
          && entry.source == 'use'
          && entry.drawId == holdingId
          && entry.delta == -cost;
      }

      // Closes the holding now, by the signed-in user, for `reason`.
      function closesAs(reason) {
        return onlyChanges(['returnedAt', 'returnedBy', 'returnReason', 'usedOn'])
          && request.resource.data.returnedAt == request.time
          && request.resource.data.returnedBy == request.auth.uid
          && request.resource.data.returnReason == reason;
      }

      // Closes the holding now as transferred to a holding that this request creates to continue it.
      function closesAsTransferred() {
        let next = request.resource.data.transferredTo;
        return onlyChanges(['returnedAt', 'returnedBy', 'returnReason', 'transferredTo'])
          && request.resource.data.returnedAt == request.time
          && request.resource.data.returnedBy == request.auth.uid
          && request.resource.data.returnReason == 'transferred'
          && next is string
          && !exists(holdingPath(next))
          && existsAfter(holdingPath(next))
          && getAfter(holdingPath(next)).data.transferredFrom == holdingId;
      }

      // Using or discarding returns a card with one copy to the pool when its holder pointed here. Otherwise (an extra
      // copy, or a repeatable card, which has no holder) the card does not change.
      function releasesCard() {
        let cardId = resource.data.cardId;
        let before = holderBefore(cardId);
        return before != null && before.userCardId == holdingId
          ? holderAfter(cardId) == null
          : holderAfter(cardId) == before;
      }

      // A transfer moves the holder of a card with one copy to the new holding when it pointed here. Otherwise the
      // card does not change.
      function movesCard() {
        let cardId = resource.data.cardId;
        let before = holderBefore(cardId);
        let next = request.resource.data.transferredTo;
        return before != null && before.userCardId == holdingId
          ? holderAfter(cardId) == {'uid': getAfter(holdingPath(next)).data.uid, 'userCardId': next}
          : holderAfter(cardId) == before;
      }
    }

    // Draws: one card drawn into a hand, or one pack opened into a hand, kept as a permanent record. Everyone signed
    // in reads every record.
    //
    // A card draw is created only together with the holding it opens and, when paid, the ledger entry and the new
    // LP; it is never changed or deleted. A player draws only into their own hand: a random draw for 1 LP, without
    // filters, or a free Cursed draw. The DM draws into any hand for free, and may record filters on a random draw.
    //
    // A pack opening is created open, together with taking the table and, when paid, its ledger entry and the new
    // balance. A player opens a pack only into their own hand, for its LP price; the DM opens one into any hand, paid
    // with any amount of the player's LP or the party's GP, or free. While it is open, the hand's owner or the DM
    // turns its cards one at a time, and then chooses one card, which ends it; only the DM cancels it, with a refund
    // of its payment. Both ends free the table. An ended pack never changes again.
    //
    // A True Word draft (`kind: 'wordDraft'`, design D5 of unify-cards-and-true-words) starts open for a player who has
    // no open draft, showing 3 words the player does not know: the player starts one for themselves and pays the price
    // in LP (1 plus the words they know), and the DM starts one for anyone, free or for any LP amount. While it is
    // open, its player or the DM learns one of its words or skips it, and only the DM cancels it, with a refund. A
    // draft never takes the table, but every step waits while a pack is open. An ended draft never changes.
    match /draws/{drawId} {
      allow read: if isMember();
      allow create: if (validDraw()
          && opensItsHolding()
          && joinsSession()
          && tableFree()
          && (paidByPlayer() || cursedForSelf() || (isFree() && isDm())))
        || (validPackOpening() && takesTable() && (packPaidByPlayer() || packByDm()))
        || (validWordDraft() && tableFree() && startsDraft() && (draftPaidByPlayer() || draftByDm()));
      allow update: if isMember()
        && resource.data.status == 'open'
        && (
          (resource.data.kind == 'pack'
            && (
              (turnsCard() && (isPackOwner() || isDm()))
              || (choosesCard() && (isPackOwner() || isDm()))
              || (cancelsPack() && isDm())
            ))
          || (resource.data.kind == 'wordDraft'
            && tableFree()
            && (
              (learnsWord() && (isPackOwner() || isDm()))
              || (skipsDraft() && (isPackOwner() || isDm()))
              || (cancelsDraft() && isDm())
            ))
        );
      allow delete: if false;

      // A filter value: a string within `max` characters, or null.
      function validFilterText(value, max) {
        return value == null || (value is string && value.size() >= 1 && value.size() <= max);
      }

      // The DM's filters, or null. Limits: keep in step with DRAW_LIMITS in src/features/draws/schema.ts.
      function validFilters(filters) {
        let fields = ['setCode', 'cost', 'mechanicPack', 'rarity', 'keyword'];
        return filters == null
          || (filters is map
            && filters.keys().hasOnly(fields)
            && filters.keys().hasAll(fields)
            && validFilterText(filters.setCode, 100)
            && validFilterText(filters.cost, 10)
            && validFilterText(filters.mechanicPack, 100)
            && (filters.rarity == null || filters.rarity in ['common', 'rare', 'blessed'])
            && validFilterText(filters.keyword, 100));
      }

      // Exactly the stored fields, drawn now by the signed-in user. A random draw gives a normal or Blessed card,
      // and a Cursed draw a Cursed card, without filters.
      function validDraw() {
        let data = request.resource.data;
        let fields = ['kind', 'uid', 'by', 'at', 'cardId', 'cardName', 'cardKind', 'holdingId', 'filters',
          'paidWith', 'cost', 'entryId', 'sessionId'];
        return isMember()
          && data.keys().hasOnly(fields)
          && data.keys().hasAll(fields)
          && data.uid is string
          && data.by == request.auth.uid
          && data.at == request.time
          && data.cardId is string
          && data.cardName is string
          && data.holdingId is string
          && data.sessionId is string
          && ((data.kind == 'random' && data.cardKind in ['normal', 'blessed'])
            || (data.kind == 'cursed' && data.cardKind == 'cursed' && data.filters == null))
          && validFilters(data.filters);
      }

      // The holding this draw names is created in this same request and names this draw. The holding's own rule
      // checks the card and the hand.
      function opensItsHolding() {
        let holding = holdingPath(request.resource.data.holdingId);
        return createdNow(holding) && getAfter(holding).data.drawId == drawId;
      }

      // The draw session named by this draw takes it in this same request (spec: live-draws, design D2): the session,
      // open, of the same kind, hand and drawer, was changed now, and its last card is this draw, its card, and the
      // back its set filter gives. The session's own rule checks that only this card was added, or that it is new.
      function joinsSession() {
        let data = request.resource.data;
        let path = drawSessionPath(data.sessionId);
        let session = getAfter(path).data;
        let entry = session.draws[session.draws.size() - 1];
        return existsAfter(path)
          && session.endedBy == null
          && session.kind == data.kind
          && session.uid == data.uid
          && session.by == data.by
          && session.lastAt == request.time
          && entry.drawId == drawId
          && entry.cardId == data.cardId
          && entry.backSet == (data.filters == null ? null : data.filters.setCode);
      }

      function isFree() {
        let data = request.resource.data;
        return data.paidWith == 'none' && data.cost == 0 && data.entryId == null;
      }

      // A player's random draw into their own hand, with the filters the table's player draw mode allows, paid
      // with 1 LP through a ledger entry that this same request creates and that names this draw. The ledger rules
      // check the amount and the balance.
      function paidByPlayer() {
        let data = request.resource.data;
        return data.kind == 'random'
          && data.uid == request.auth.uid
          && playerFiltersAllowed(data.filters)
          && data.paidWith == 'lp'
          && data.cost == 1
          && data.entryId is string
          && createdNow(ledgerPath(data.entryId))
          && getAfter(ledgerPath(data.entryId)).data.drawId == drawId;
      }

      // The filters a player's draw may record under the table's player draw mode (spec: card-draws, "The server
      // checks a player's filters against the mode"): none under 'off', the set, cost, mechanic pack and rarity under
      // 'filtered', and the keyword too under 'pick'. A missing table, or one from before the setting, is 'off'. The
      // table is read once per request: tableFree() reads it too. Keep in step with playerFiltersAllowed in
      // src/features/table/playerDraw.ts.
      function playerFiltersAllowed(filters) {
        let mode = exists(tablePath()) ? get(tablePath()).data.get('playerDraw', 'off') : 'off';
        return filters == null
          || mode == 'pick'
          || (mode == 'filtered' && filters.keyword == null);
      }

      // A free Cursed draw into the drawer's own hand.
      function cursedForSelf() {
        return request.resource.data.kind == 'cursed'
          && request.resource.data.uid == request.auth.uid
          && isFree();
      }

      // The LP price of each pack type. Keep in step with PACK_PRICES in src/features/packs/catalog.ts.
      function packPrice(type) {
        return {
          'standard': 2,
          'premium': 3,
          'cursed': 1,
          'pandemonium': 3,
          'pandemoniumCursed': 3,
          'mechanic': 4,
          'golden': 4,
          'cursedGolden': 3
        }[type];
      }

      // The pack types that also show one mandatory Cursed card. Keep in step with CURSED_PACK_TYPES.
      function isCursedPack(type) {
        return type in ['cursed', 'pandemoniumCursed', 'cursedGolden'];
      }

      function validScope(value) {
        return value is string && value.size() >= 1 && value.size() <= 100;
      }

      // The pack types of one set name their set, a Mechanic Pack its mechanic pack, and the Golden types neither.
      function validPackScope(data) {
        return data.packType in ['standard', 'premium', 'cursed', 'pandemonium', 'pandemoniumCursed']
          ? validScope(data.setCode) && data.mechanicPack == null
          : data.packType == 'mechanic'
            ? data.setCode == null && validScope(data.mechanicPack)
            : data.packType in ['golden', 'cursedGolden'] && data.setCode == null && data.mechanicPack == null;
      }

      function validCardId(value) {
        return value is string && value.size() >= 1 && value.size() <= 300;
      }

      // The shown cards: 5 distinct card IDs, and a sixth for a Cursed type.
      function validOffered(offered, size) {
        return offered is list
          && offered.size() == size
          && offered.toSet().size() == size
          && validCardId(offered[0])
          && validCardId(offered[1])
          && validCardId(offered[2])
          && validCardId(offered[3])
          && validCardId(offered[4])
          && (size == 5 || validCardId(offered[5]));
      }

      // A new, open pack with exactly the stored fields, opened now by the signed-in user into the hand of someone
      // with a profile, with no card turned or chosen yet.
      function validPackOpening() {
        let data = request.resource.data;
        let fields = ['kind', 'uid', 'by', 'at', 'packType', 'setCode', 'mechanicPack', 'offered', 'revealed',
          'paidWith', 'cost', 'entryId', 'status', 'closedAt', 'closedBy', 'chosen', 'cursed', 'refundEntryId'];
        return isMember()
          && data.keys().hasOnly(fields)
          && data.keys().hasAll(fields)
          && data.kind == 'pack'
          && data.uid is string
          && data.by == request.auth.uid
          && data.at == request.time
          && validPackScope(data)
          && validOffered(data.offered, isCursedPack(data.packType) ? 6 : 5)
          && data.revealed == []
          && data.status == 'open'
          && data.closedAt == null
          && data.closedBy == null
          && data.chosen == null
          && data.cursed == null
          && data.refundEntryId == null
          && exists(userPath(data.uid));
      }

      // This pack takes the free table.
      function takesTable() {
        return openPackBefore() == null && openPackAfter() == drawId;
      }

      // This pack ends and frees the table it held.
      function releasesTable() {
        return openPackBefore() == drawId && openPackAfter() == null;
      }

      // A ledger entry that this same request creates names this pack. The ledger rules check its amount and account.
      function paysWith(entryId) {
        return entryId is string
          && createdNow(ledgerPath(entryId))
          && getAfter(ledgerPath(entryId)).data.drawId == drawId;
      }

      // A player's pack, into their own hand, paid with exactly its LP price.
      function packPaidByPlayer() {
        let data = request.resource.data;
        return data.uid == request.auth.uid
          && data.paidWith == 'lp'
          && data.cost == packPrice(data.packType)
          && paysWith(data.entryId);
      }

      // The DM's pack: free, or paid with any whole amount of the player's LP or the party's GP.
      function packByDm() {
        let data = request.resource.data;
        return ((data.paidWith == 'none' && data.cost == 0 && data.entryId == null)
            || (data.paidWith in ['lp', 'gp']
              && data.cost is int
              && data.cost >= 1
              && data.cost <= 1000000
              && paysWith(data.entryId)))
          && isDm();
      }

      // The signed-in user is the hand's owner of this pack or draft.
      function isPackOwner() {
        return request.auth.uid == resource.data.uid;
      }

      // Turns one more card face up: the next position is added at the end, once, and it is one of the shown cards.
      function turnsCard() {
        let before = resource.data.revealed;
        let after = request.resource.data.revealed;
        let n = before.size();
        return onlyChanges(['revealed'])
          && after is list
          && after.size() == n + 1
          && after[n] is int
          && after[n] >= 0
          && after[n] < resource.data.offered.size()
          && !(after[n] in before)
          && after == before.concat([after[n]]);
      }

      // A holding that this same request creates names this pack.
      function opensPackHolding(holdingId) {
        return holdingId is string
          && createdNow(holdingPath(holdingId))
          && getAfter(holdingPath(holdingId)).data.drawId == drawId;
      }

      function validChosenName(value) {
        return value is string && value.size() >= 1 && value.size() <= 200;
      }

      // Ends the pack with a choice, now, by the signed-in user, after every card was turned: one shown normal or
      // Blessed card, and for a Cursed type also the shown Cursed card, each into a holding created in this same
      // request. The holdings' own rule checks the cards and the hand.
      function choosesCard() {
        let before = resource.data;
        let after = request.resource.data;
        let chosen = after.chosen;
        let cursed = after.cursed;
        return onlyChanges(['status', 'closedAt', 'closedBy', 'chosen', 'cursed'])
          && after.status == 'chosen'
          && after.closedAt == request.time
          && after.closedBy == request.auth.uid
          && before.revealed.size() == before.offered.size()
          && chosen is map
          && chosen.keys().hasOnly(['cardId', 'cardName', 'cardKind', 'holdingId'])
          && chosen.keys().hasAll(['cardId', 'cardName', 'cardKind', 'holdingId'])
          && chosen.cardId in before.offered
          && chosen.cardKind in ['normal', 'blessed']
          && validChosenName(chosen.cardName)
          && opensPackHolding(chosen.holdingId)
          && (isCursedPack(before.packType)
            ? cursed is map
              && cursed.keys().hasOnly(['cardId', 'cardName', 'holdingId'])
              && cursed.keys().hasAll(['cardId', 'cardName', 'holdingId'])
              && cursed.cardId in before.offered
              && cursed.cardId != chosen.cardId
              && cursed.holdingId != chosen.holdingId
              && validChosenName(cursed.cardName)
              && opensPackHolding(cursed.holdingId)
            : cursed == null)
          && releasesTable();
      }

      // Ends the pack without a card, now, by the signed-in user. A paid pack names its refund, which this same
      // request creates; the ledger rules check that it returns the payment.
      function cancelsPack() {
        let after = request.resource.data;
        return onlyChanges(['status', 'closedAt', 'closedBy', 'refundEntryId'])
          && after.status == 'cancelled'
          && after.closedAt == request.time
          && after.closedBy == request.auth.uid
          && (resource.data.paidWith == 'none'
            ? after.refundEntryId == null
            : paysWith(after.refundEntryId))
          && releasesTable();
      }

      // A new, open True Word draft with exactly the stored fields, started now by the signed-in user for someone with
      // a profile.
      function validWordDraft() {
        let data = request.resource.data;
        let fields = ['kind', 'uid', 'by', 'at', 'offered', 'status', 'paidWith', 'cost', 'entryId', 'closedAt',
          'closedBy', 'learned', 'refundEntryId'];
        return isMember()
          && data.keys().hasOnly(fields)
          && data.keys().hasAll(fields)
          && data.kind == 'wordDraft'
          && data.uid is string
          && exists(userPath(data.uid))
          && data.by == request.auth.uid
          && data.at == request.time
          && data.offered is list
          && data.offered.size() == 3
          && data.offered[0] is string
          && data.offered[1] is string
          && data.offered[2] is string
          && data.offered.toSet().size() == 3
          && data.status == 'open'
          && data.closedAt == null
          && data.closedBy == null
          && data.learned == null
          && data.refundEntryId == null;
      }

      // The player had no open draft, this one becomes it, and none of the shown words is known.
      function startsDraft() {
        let data = request.resource.data;
        return openDraftBefore(data.uid) == null
          && openDraftAfter(data.uid) == drawId
          && !knownBefore(data.uid).keys().hasAny(data.offered);
      }

      // A player's own draft, paid with exactly 1 LP plus the number of words they know.
      function draftPaidByPlayer() {
        let data = request.resource.data;
        return data.uid == request.auth.uid
          && data.paidWith == 'lp'
          && data.cost == 1 + knownBefore(data.uid).size()
          && paysWith(data.entryId);
      }

      // The DM's draft: free, or paid with any whole amount of the player's LP.
      function draftByDm() {
        let data = request.resource.data;
        return ((data.paidWith == 'none' && data.cost == 0 && data.entryId == null)
            || (data.paidWith == 'lp'
              && data.cost is int
              && data.cost >= 1
              && data.cost <= 1000000
              && paysWith(data.entryId)))
          && isDm();
      }

      // Ends the draft, by the one who acts, and closes it in the player's state in this same request.
      function endsBy(status) {
        let after = request.resource.data;
        return after.status == status
          && after.closedAt == request.time
          && after.closedBy == request.auth.uid
          && openDraftAfter(resource.data.uid) == null;
      }

      // One of the shown words is learned, with the holding that this same request opens for it.
      function learnsWord() {
        let learned = request.resource.data.learned;
        let holding = getAfter(holdingPath(learned.holdingId)).data;
        return onlyChanges(['status', 'closedAt', 'closedBy', 'learned'])
          && endsBy('learned')
          && learned is map
          && learned.keys().hasOnly(['cardId', 'cardName', 'holdingId'])
          && learned.keys().hasAll(['cardId', 'cardName', 'holdingId'])
          && learned.cardId in resource.data.offered
          && learned.holdingId is string
          && createdNow(holdingPath(learned.holdingId))
          && holding.cardId == learned.cardId
          && holding.cardName == learned.cardName
          && holding.givenVia == 'draft'
          && holding.drawId == drawId;
      }

      // Skipped: no word, and the payment stays spent.
      function skipsDraft() {
        return onlyChanges(['status', 'closedAt', 'closedBy']) && endsBy('skipped');
      }

      // Cancelled by the DM: no word, and a paid draft's cost is refunded in this same request.
      function cancelsDraft() {
        let after = request.resource.data;
        return onlyChanges(['status', 'closedAt', 'closedBy', 'refundEntryId'])
          && endsBy('cancelled')
          && (resource.data.paidWith == 'none'
            ? after.refundEntryId == null
            : paysWith(after.refundEntryId));
      }
    }

    // Draw sessions: one opening of the draw dialog that drew at least one card, at `drawSessions/{sessionId}` (spec:
    // live-draws, design D1-D3). Everyone signed in reads them. A session is created with its first draw, and each
    // later draw joins it, by the same drawer, in the draw's own request; the draw's rule checks the rest. The hand's
    // owner and the DM turn its cards and end it, with no need for a free table. An ended session never changes again,
    // and no session is deleted. Staleness is read on the devices, never written.
    match /drawSessions/{sessionId} {
      allow read: if isMember();
      allow create: if isMember() && validNewSession();
      allow update: if isMember()
        && resource.data.endedBy == null
        && (addsDraw()
          || ((turnsSessionCard() || endsSession())
            && (request.auth.uid == resource.data.uid || isDm())));
      allow delete: if false;

      // One card of the session: a draw that this same request creates and that names this session, its card, and
      // the set whose cardback it had (none in a Cursed session). Keep the limit in step with CARD_LIMITS.setCode.
      function validSessionDraw(entry, kind) {
        let fields = ['drawId', 'cardId', 'backSet'];
        return entry is map
          && entry.keys().hasOnly(fields)
          && entry.keys().hasAll(fields)
          && entry.drawId is string
          && entry.cardId is string
          && (entry.backSet == null
            || (kind == 'random' && entry.backSet is string && entry.backSet.size() >= 1
              && entry.backSet.size() <= 100))
          && createdNow(drawPath(entry.drawId))
          && getAfter(drawPath(entry.drawId)).data.get('sessionId', null) == sessionId;
      }

      // A new, open session with exactly the stored fields, started now by the signed-in user with one card.
      function validNewSession() {
        let data = request.resource.data;
        let fields = ['kind', 'uid', 'by', 'startedAt', 'lastAt', 'draws', 'turned', 'endedAt', 'endedBy'];
        return data.keys().hasOnly(fields)
          && data.keys().hasAll(fields)
          && data.kind in ['random', 'cursed']
          && data.uid is string
          && data.by == request.auth.uid
          && data.startedAt == request.time
          && data.lastAt == request.time
          && data.draws is list
          && data.draws.size() == 1
          && validSessionDraw(data.draws[0], data.kind)
          && data.turned == []
          && data.endedAt == null
          && data.endedBy == null;
      }

      // One more card, at the end, by the session's drawer. Keep the limit in step with DRAW_SESSION_MAX.
      function addsDraw() {
        let before = resource.data.draws;
        let after = request.resource.data.draws;
        let n = before.size();
        return onlyChanges(['draws', 'lastAt'])
          && request.auth.uid == resource.data.by
          && request.resource.data.lastAt == request.time
          && after is list
          && after.size() == n + 1
          && after.size() <= 500
          && after[0:n] == before
          && validSessionDraw(after[n], resource.data.kind);
      }

      // One more card face up, added at the end, once, and one of the session's cards.
      function turnsSessionCard() {
        let before = resource.data.turned;
        let after = request.resource.data.turned;
        let n = before.size();
        return onlyChanges(['turned', 'lastAt'])
          && request.resource.data.lastAt == request.time
          && after is list
          && after.size() == n + 1
          // An empty slice (`after[0:0]`) is an evaluation error in the rules, so the first turn skips the check.
          && (n == 0 || after[0:n] == before)
          && after[n] is int
          && after[n] >= 0
          && after[n] < resource.data.draws.size()
          && !(after[n] in before);
      }

      // The end, now, by the signed-in user.
      function endsSession() {
        let data = request.resource.data;
        return onlyChanges(['endedAt', 'endedBy', 'lastAt'])
          && data.endedAt == request.time
          && data.lastAt == request.time
          && data.endedBy == request.auth.uid;
      }
    }

    // The table, at `table/main`: which pack is open, and the player draw mode (spec: table-settings). Everyone signed
    // in reads it. A missing table holds no pack, and its mode is off; so is the mode of a table written before the
    // setting existed.
    // - The pack fields change only together with a pack: taken by the opening that this same request creates, and
    //   freed by the choice or cancel that ends the pack in this same request. The pack's rules decide who may do
    //   either. A pack step changes nothing else (design D1 of player-draw-modes).
    // - Only the DM changes the mode, to one of the three, together with the `tableChanges` record that this same
    //   request creates for it, and nothing else. A mode change does not wait for an open pack: it moves no card and
    //   no balance. Before the first pack, the DM's change creates the table, with no pack open.
    match /table/main {
      allow read: if isMember();
      allow create: if isMember()
        && ((request.resource.data.keys().hasOnly(['openPackId'])
            && request.resource.data.keys().hasAll(['openPackId'])
            && takenBy(request.resource.data.openPackId))
          || (request.resource.data.keys().hasOnly(tableKeys())
            && request.resource.data.keys().hasAll(tableKeys())
            && request.resource.data.openPackId == null
            && setsPlayerDraw('off')));
      allow update: if isMember()
        && request.resource.data.keys().hasAll(['openPackId'])
        && ((onlyChanges(['openPackId'])
            && ((resource.data.openPackId == null && takenBy(request.resource.data.openPackId))
              || (resource.data.openPackId is string
                && request.resource.data.openPackId == null
                && freedBy(resource.data.openPackId))))
          || (request.resource.data.keys().hasOnly(tableKeys())
            && request.resource.data.keys().hasAll(tableKeys())
            && onlyChanges(['playerDraw', 'playerDrawChangeId'])
            && setsPlayerDraw(resource.data.get('playerDraw', 'off'))));
      allow delete: if false;

      function tableKeys() {
        return ['openPackId', 'playerDraw', 'playerDrawChangeId'];
      }

      // A pack that this same request creates, open.
      function takenBy(packId) {
        return packId is string
          && createdNow(drawPath(packId))
          && getAfter(drawPath(packId)).data.kind == 'pack'
          && getAfter(drawPath(packId)).data.status == 'open';
      }

      // The open pack ends in this same request.
      function freedBy(packId) {
        return get(drawPath(packId)).data.status == 'open'
          && getAfter(drawPath(packId)).data.status in ['chosen', 'cancelled'];
      }

      // The DM sets a mode from `before`, and the record this same request creates names that step.
      function setsPlayerDraw(before) {
        let data = request.resource.data;
        let changeId = data.playerDrawChangeId;
        return data.playerDraw in ['off', 'filtered', 'pick']
          && changeId is string
          && createdNow(tableChangePath(changeId))
          && getAfter(tableChangePath(changeId)).data.setting == 'playerDraw'
          && getAfter(tableChangePath(changeId)).data.before == before
          && getAfter(tableChangePath(changeId)).data.after == data.playerDraw
          && isDm();
      }
    }

    // Table change records: one per change of a table setting by the DM (design D2 of player-draw-modes), so far only
    // the player draw mode. Everyone signed in reads them. Only the DM creates one, together with the table change it
    // records: the table now points at it, with its mode after, and its mode before is the table's before. A record
    // never changes and is never deleted.
    match /tableChanges/{changeId} {
      allow read: if isMember();
      allow create: if isMember() && validTableChange() && isDm();
      allow update, delete: if false;

      function validTableChange() {
        let data = request.resource.data;
        let fields = ['by', 'at', 'setting', 'before', 'after'];
        let modes = ['off', 'filtered', 'pick'];
        let before = exists(tablePath()) ? get(tablePath()).data.get('playerDraw', 'off') : 'off';
        return data.keys().hasOnly(fields)
          && data.keys().hasAll(fields)
          && data.by == request.auth.uid
          && data.at == request.time
          && data.setting == 'playerDraw'
          && data.before in modes
          && data.after in modes
          && data.before != data.after
          && data.before == before
          && existsAfter(tablePath())
          && getAfter(tablePath()).data.get('playerDrawChangeId', null) == changeId
          && getAfter(tablePath()).data.get('playerDraw', 'off') == data.after;
      }
    }

    // Definition change records: one per DM step on a card or a True Word, holding the definition before and after
    // (design D4 of add-card-and-word-editing). Both kinds live in `cards` (design D1 of unify-cards-and-true-words),
    // and a True Word's records have the target 'word'. Everyone signed in reads the public ones, the steps players
    // can see; only the DM reads the others.
    // Only the DM creates them, each together with the change it records; the import script writes its own with the
    // Admin SDK. A record never changes and is never deleted.
    match /definitionChanges/{changeId} {
      allow read: if isMember() && (resource.data.public == true || isDm());
      allow create: if isMember() && validChangeRecord() && isDm();
      allow update, delete: if false;

      function recordKeys() {
        return ['target', 'targetId', 'name', 'step', 'before', 'after', 'public', 'by', 'at'];
      }

      function targetPath(data) {
        return cardPath(data.targetId);
      }

      function statusOf(snapshot) {
        return snapshot == null ? null : snapshot.status;
      }

      // `before` is the stored definition before this request (null when it did not exist), and `after` the stored one
      // after it (null when it is deleted). A stale `before`, from a form opened before another change, is refused.
      function agreesWithTarget(data) {
        let path = targetPath(data);
        return (data.before == null ? !exists(path) : data.before == cardSnapshot(get(path).data))
          && (data.after == null ? !existsAfter(path) : data.after == cardSnapshot(getAfter(path).data));
      }

      // The record belongs to a change in this request: the definition now points at it, or, for a delete, it has the
      // ID that the deleted draft's newest record fixes. So no record exists without its change.
      function explainsTarget(data) {
        let path = targetPath(data);
        return data.after != null
          ? getAfter(path).data.changeId == changeId
          : changeId == deleteRecordId(data.targetId, get(path).data.get('changeId', ''));
      }

      function validChangeRecord() {
        let data = request.resource.data;
        return data.keys().hasOnly(recordKeys())
          && data.keys().hasAll(recordKeys())
          && data.target in ['card', 'word']
          && data.targetId is string
          && (data.before != null || data.after != null)
          && data.target == targetOf(data.after != null ? data.after.kind : data.before.kind)
          && agreesWithTarget(data)
          && explainsTarget(data)
          && data.step == stepFor(statusOf(data.before), statusOf(data.after))
          && data.public == (visibleSnapshot(data.before) || visibleSnapshot(data.after))
          && data.name == (data.after != null ? data.after.name : data.before.name)
          && data.by == request.auth.uid
          && data.at == request.time;
      }
    }

    // Card sets (spec: card-sets). Everyone signed in reads them; only the DM adds, edits, moves and deletes one, each
    // together with its record in setChanges. The ID is the normalized code, which the client computes: the rules
    // cannot normalize, so they check the shape and keep the code from changing. A change of the pack layout and a
    // delete wait for an open pack. The import writes with the Admin SDK.
    match /sets/{setId} {
      allow read: if isMember();
      allow create: if isMember()
        && setId.matches('[a-z0-9]+')
        && validSet(request.resource.data)
        && setRecorded(request.resource.data.changeId, 'added')
        && isDm();
      allow update: if isMember()
        && validSet(request.resource.data)
        && request.resource.data.code == resource.data.code
        && request.resource.data.changeId != resource.data.get('changeId', null)
        && (movedNow() || editedNow())
        && isDm();
      allow delete: if isMember()
        && deletionRecorded()
        && tableFree()
        && isDm();

      function setKeys() {
        return ['code', 'name', 'aliases', 'position', 'packLayout', 'cardback', 'mascot', 'changeId'];
      }

      // A set picture: absent (never had one), null (removed, or added without one), or a file of this set.
      function validSetPicture(data, key) {
        return data.get(key, null) == null
          || (data[key] is string && data[key].matches('sets/' + setId + '/[0-9a-f]{10}[.]webp'));
      }

      // The limits of SET_LIMITS in src/features/sets/schema.ts.
      function validSet(data) {
        return data.keys().hasOnly(setKeys())
          && data.keys().hasAll(['code', 'name', 'aliases', 'position', 'packLayout', 'changeId'])
          && data.code is string && data.code.size() >= 1 && data.code.size() <= 100
          && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
          && data.aliases is list && data.aliases.size() <= 10
          && data.position is int
          && data.packLayout in ['standard', 'pandemonium']
          && validSetPicture(data, 'cardback')
          && validSetPicture(data, 'mascot')
          && data.changeId is string;
      }

      // The set's newest record is created in this same request, for this step.
      function setRecorded(changeId, step) {
        return changeId is string
          && createdNow(setChangePath(changeId))
          && getAfter(setChangePath(changeId)).data.step == step
          && (step == 'moved' || getAfter(setChangePath(changeId)).data.setId == setId);
      }

      // A move changes only the position; its one record covers both sets that swap places.
      function movedNow() {
        return onlyChanges(['position', 'changeId'])
          && setRecorded(request.resource.data.changeId, 'moved');
      }

      // An edit keeps the position, and changes the pack layout only while no pack is open.
      function editedNow() {
        return request.resource.data.position == resource.data.position
          && (request.resource.data.packLayout == resource.data.packLayout || tableFree())
          && setRecorded(request.resource.data.changeId, 'edited');
      }

      function deletionRecorded() {
        let changeId = resource.data.get('changeId', null);
        return changeId is string
          && setRecorded(deleteRecordId(setId, changeId), 'deleted');
      }
    }

    // The set change records (spec: card-sets, "Set change records"). Everyone signed in reads them; the DM creates
    // one with each set step, and none is ever changed or deleted. The import writes its records with the Admin SDK.
    match /setChanges/{changeId} {
      allow read: if isMember();
      allow create: if isMember() && validSetChange() && isDm();
      allow update, delete: if false;

      function setChangeKeys() {
        return ['by', 'at', 'step', 'setId', 'code', 'name', 'fields', 'direction', 'added', 'pictured'];
      }

      // The record belongs to a step in this request: the set now points at it, or, for a delete, it has the ID that
      // the deleted set's newest record fixes and the set is gone.
      function explainsSet(data) {
        let path = setPath(data.setId);
        return data.step == 'deleted'
          ? exists(path)
            && !existsAfter(path)
            && changeId == deleteRecordId(data.setId, get(path).data.get('changeId', ''))
          : existsAfter(path) && getAfter(path).data.changeId == changeId;
      }

      function validSetChange() {
        let data = request.resource.data;
        return data.keys().hasOnly(setChangeKeys())
          && data.keys().hasAll(setChangeKeys())
          && data.step in ['added', 'edited', 'moved', 'deleted']
          && data.setId is string
          && data.code is string
          && data.name is string
          && data.fields is list && data.fields.size() <= 5
          && (data.step == 'moved' ? data.direction in ['up', 'down'] : data.direction == null)
          && data.added == []
          && data.pictured == []
          && explainsSet(data)
          && data.by == request.auth.uid
          && data.at == request.time;
      }
    }

    // A player's True Word state: the known words with their open records, the open draft, and the record that
    // last changed `known`. Everyone signed in reads it. It checks only that it agrees with the draft or record that
    // this same request changes; those documents decide who may act. Every change waits while a pack is open.
    match /playerWords/{uid} {
      allow read: if isMember();
      allow create, update: if isMember()
        && validPlayerWords()
        && tableFree()
        && (opensDraft() || endsDraft() || learnsFromDraft() || teaches() || takesBack());
      allow delete: if false;

      function knownNow() {
        return resource == null ? {} : resource.data.known;
      }

      function openDraftNow() {
        return resource == null ? null : resource.data.openDraftId;
      }

      function holdingNow() {
        return resource == null ? null : resource.data.holdingId;
      }

      function validPlayerWords() {
        let next = request.resource.data;
        return next.keys().hasOnly(['known', 'openDraftId', 'holdingId'])
          && next.keys().hasAll(['known', 'openDraftId', 'holdingId'])
          && next.known is map
          && (next.openDraftId == null || next.openDraftId is string)
          && (next.holdingId == null || next.holdingId is string);
      }

      function keepsKnown() {
        let next = request.resource.data;
        return next.known == knownNow() && next.holdingId == holdingNow();
      }

      // A draft for this player that this same request creates becomes the open draft.
      function opensDraft() {
        let next = request.resource.data;
        return openDraftNow() == null
          && next.openDraftId is string
          && createdNow(drawPath(next.openDraftId))
          && getAfter(drawPath(next.openDraftId)).data.kind == 'wordDraft'
          && getAfter(drawPath(next.openDraftId)).data.uid == uid
          && keepsKnown();
      }

      // The open draft is skipped or cancelled in this same request.
      function endsDraft() {
        let next = request.resource.data;
        let open = openDraftNow();
        return open != null
          && next.openDraftId == null
          && getAfter(drawPath(open)).data.status in ['skipped', 'cancelled']
          && keepsKnown();
      }

      // `known` gains exactly the word of the True Word holding that this same request opens for this player.
      function gainsHolding(holdingId) {
        let holding = getAfter(holdingPath(holdingId)).data;
        let diff = request.resource.data.known.diff(knownNow());
        return holdingId is string
          && createdNow(holdingPath(holdingId))
          && holding.uid == uid
          && holding.cardKind == 'trueWord'
          && diff.addedKeys() == [holding.cardId].toSet()
          && diff.removedKeys().size() == 0
          && diff.changedKeys().size() == 0
          && request.resource.data.known[holding.cardId] == holdingId;
      }

      // The open draft is learned from in this same request: its word joins `known`, and the draft closes.
      function learnsFromDraft() {
        let next = request.resource.data;
        let open = openDraftNow();
        return open != null
          && next.openDraftId == null
          && getAfter(drawPath(open)).data.status == 'learned'
          && getAfter(drawPath(open)).data.learned.holdingId == next.holdingId
          && gainsHolding(next.holdingId);
      }

      // The DM teaches a word: it joins `known`, and the open draft, if any, stays.
      function teaches() {
        let next = request.resource.data;
        return next.openDraftId == openDraftNow()
          && getAfter(holdingPath(next.holdingId)).data.givenVia == 'dm'
          && gainsHolding(next.holdingId);
      }

      // The DM takes back a word: its open holding closes in this same request, and the word leaves `known`.
      function takesBack() {
        let next = request.resource.data;
        let holding = getAfter(holdingPath(next.holdingId)).data;
        let diff = next.known.diff(knownNow());
        return resource != null
          && next.openDraftId == openDraftNow()
          && next.holdingId is string
          && get(holdingPath(next.holdingId)).data.returnedAt == null
          && holding.returnReason == 'discarded'
          && holding.uid == uid
          && knownNow()[holding.cardId] == next.holdingId
          && diff.removedKeys() == [holding.cardId].toSet()
          && diff.addedKeys().size() == 0
          && diff.changedKeys().size() == 0;
      }
    }

    // Kept uses (design D5 of unify-cards-and-true-words): one use of a card or True Word whose "Kullanınca elde kalır"
    // is on, so the use does not close its holding. Everyone signed in reads every use. While the table is free, the
    // holding's player or the DM records a use of an open holding: the player pays the price of the cost in this hand,
    // the DM any whole amount. A paid use comes with its ledger entry and the player's new LP in this same request. A
    // use is never changed or deleted.
    match /uses/{useId} {
      allow read: if isMember();
      allow create: if isMember()
        && validUse()
        && tableFree()
        && ((isSelf(request.resource.data.uid) && priceAllows(useCost(), request.resource.data.cost))
          || isDm());
      allow update, delete: if false;

      // The stored fields, used now by the signed-in user, for an open holding of an active or retired definition kept
      // on use, with its payment, and the character it was used on, if any.
      function validUse() {
        let data = request.resource.data;
        let holding = get(holdingPath(data.holdingId)).data;
        let card = get(cardPath(data.cardId)).data;
        let fields = ['uid', 'cardId', 'cardName', 'cardKind', 'holdingId', 'by', 'at', 'cost', 'entryId'];
        return data.keys().hasOnly(fields.concat(['usedOn', 'usedOnCharacterId']))
          && data.keys().hasAll(fields)
          && (data.get('usedOn', null) == null
            || (data.usedOn is string && data.usedOn.size() >= 1 && data.usedOn.size() <= 100))
          && usedCharacterMatches(data)
          && data.uid is string
          && data.cardId is string
          && data.holdingId is string
          && data.by == request.auth.uid
          && data.at == request.time
          && data.cost is int
          && data.cost >= 0
          && data.cost <= 1000000
          && holding.uid == data.uid
          && holding.cardId == data.cardId
          && holding.returnedAt == null
          && card.kind == data.cardKind
          && card.isKeptOnUse == true
          && playerVisible(card.status)
          && data.cardName == card.name
          && (data.cost == 0
            ? data.entryId == null
            : data.entryId is string && paidByUseEntry(data.entryId));
      }

      // The cost in this hand: the DM's override on the holding, or the definition's own cost (missing: none).
      function useCost() {
        let holding = get(holdingPath(request.resource.data.holdingId)).data;
        return holding.costOverride != null
          ? holding.costOverride
          : get(cardPath(request.resource.data.cardId)).data.get('cost', null);
      }

      // A ledger entry created in this same request pays this use's cost.
      function paidByUseEntry(entryId) {
        let entry = getAfter(ledgerPath(entryId)).data;
        return createdNow(ledgerPath(entryId))
          && entry.source == 'keptUse'
          && entry.drawId == useId
          && entry.delta == -request.resource.data.cost;
      }
    }

    // A note about the player `uid` as this request writes it: exactly its text (at most 2000 characters; keep in
    // step with NOTE_LIMITS in src/features/player-notes/schema.ts), the signed-in user as its last editor, and
    // the server time. Only users with a profile have notes. Notes are not table actions, so an open pack does not
    // stop them.
    function validNoteDoc(uid) {
      let data = request.resource.data;
      return isMember()
        && data.keys().hasOnly(['text', 'updatedBy', 'updatedAt'])
        && data.keys().hasAll(['text', 'updatedBy', 'updatedAt'])
        && data.text is string
        && data.text.size() <= 2000
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time
        && exists(userPath(uid));
    }

    // Characters (design D3 of add-characters): a user's player characters and the DM's NPCs. Everyone signed in reads
    // them. A player adds their own, and the DM one for anyone with a profile. The owner and the DM rename one,
    // change its photo and its sheet link (add-character-sheet-link), archive it and bring it back. Nothing else
    // changes, and a character is never deleted. They are not table actions: an open pack does not stop them.
    match /characters/{characterId} {
      allow read: if isMember();
      allow create: if isMember()
        && (isSelf(request.resource.data.uid) || isDm())
        && validCharacter(request.resource.data)
        && request.resource.data.archived == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && exists(userPath(request.resource.data.uid));
      allow update: if isMember()
        && (isSelf(resource.data.uid) || isDm())
        && onlyChanges(['name', 'picture', 'archived', 'initiativeModifier', 'sheetUrl'])
        && validCharacter(request.resource.data);
      allow delete: if false;

      // Exactly the stored fields, a name of 1 to 40 characters, no photo or one of this very character's,
      // optionally the initiative modifier it last rolled with, a whole number from -10 to +30 (spec: characters,
      // "Valid character records"), and optionally the link to its sheet (spec: characters, "Character sheet links").
      // Keep in step with src/features/characters/schema.ts.
      function validCharacter(data) {
        let fields = ['uid', 'name', 'picture', 'archived', 'createdAt', 'createdBy'];
        return data.keys().hasOnly(fields.concat(['initiativeModifier', 'sheetUrl']))
          && data.keys().hasAll(fields)
          && (!('initiativeModifier' in data) || validInitiativeModifier(data.initiativeModifier))
          && (!('sheetUrl' in data) || validSheetUrl(data.sheetUrl))
          && data.uid is string
          && textOfSize(data.name, 40)
          && data.archived is bool
          && (data.picture == null
            || (data.picture is string
              && data.picture.matches('characters/' + characterId + '/[0-9a-f]{10}[.]webp')));
      }

      // A sheet link: an http(s) address of at most 2048 characters (design D2 of add-character-sheet-link). RE2's
      // `.` takes anything but a line break. Keep in step with `sheetUrl` and CHARACTER_LIMITS in
      // src/features/characters/schema.ts.
      function validSheetUrl(value) {
        return value is string && value.size() <= 2048 && value.matches('https?://.+');
      }
    }

    // Effects on a character (design D1-D3 of add-character-effects, D6 of unify-cards-and-true-words). Everyone signed
    // in reads them. An effect is created and deleted, never changed. A card's or a True Word's effect is created only
    // with its use, in the same request, by the user who makes the use, and only when its "Kullanınca efekt bırakır"
    // is on; a player writes their own effect on their own character, and the DM one on any character. Effects by hand
    // are not table actions: an open pack does not stop them.
    match /characterEffects/{effectId} {
      allow read: if isMember();
      allow create: if isMember()
        && validEffect(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.source in ['card', 'word'] && followsUse(request.resource.data))
          || (request.resource.data.source == 'own' && writtenByHand(request.resource.data)
            && isSelf(request.resource.data.uid) && onOpenCharacter(request.resource.data))
          || (request.resource.data.source == 'dm' && writtenByHand(request.resource.data)
            && isDm() && onOpenCharacter(request.resource.data))
        );
      allow update: if false;
      // A use's effect: the character's owner, the user who made the use, or the DM. An own effect: the owner or the
      // DM. A DM effect: the DM alone.
      allow delete: if isMember()
        && (
          ((resource.data.source == 'card' || resource.data.source == 'word')
            && (isSelf(resource.data.uid) || request.auth.uid == resource.data.createdBy || isDm()))
          || (resource.data.source == 'own' && (isSelf(resource.data.uid) || isDm()))
          || (resource.data.source == 'dm' && isDm())
        );

      // Exactly the stored fields. A use's effect names its use; one by hand names none. Only a card's is Cursed.
      // Keep in step with src/features/characters/effects.ts.
      function validEffect(data) {
        let fields = ['characterId', 'uid', 'source', 'sourceId', 'name', 'text', 'cursed', 'createdBy',
          'createdAt'];
        let fromUse = data.source == 'card' || data.source == 'word';
        return data.keys().hasOnly(fields)
          && data.keys().hasAll(fields)
          && data.characterId is string
          && data.uid is string
          && data.source in ['card', 'word', 'own', 'dm']
          && (fromUse ? data.sourceId is string : data.sourceId == null)
          && textOfSize(data.name, 200)
          && data.text is string
          && data.text.size() <= 2000
          && data.cursed is bool
          && (data.source == 'card' || data.cursed == false);
      }

      // An effect written by hand: a name of 1 to 60 characters and a text of 1 to 500.
      function writtenByHand(data) {
        return textOfSize(data.name, 60) && textOfSize(data.text, 500);
      }

      // The character exists, is not archived, and belongs to the effect's `uid`.
      function onOpenCharacter(data) {
        let character = get(characterPath(data.characterId)).data;
        return character.archived == false && character.uid == data.uid;
      }

      // A use in this same request, by the signed-in user, on this character, which belongs to the effect's `uid`: a
      // kept use's record (`uses`) when one is created now under this ID, otherwise a holding closed now as used. The
      // source is 'word' for a True Word and 'card' otherwise, and only a Cursed card's effect is Cursed.
      function followsUse(data) {
        return existsAfter(usePath(data.sourceId)) ? followsKeptUse(data) : followsClosedUse(data);
      }

      // A holding that was open and is now closed as used, of a card whose "Kullanınca efekt bırakır" is on.
      function followsClosedUse(data) {
        let after = getAfter(holdingPath(data.sourceId)).data;
        return data.source == 'card'
          && get(holdingPath(data.sourceId)).data.returnReason == null
          && after.returnReason == 'used'
          && after.returnedBy == request.auth.uid
          && after.get('usedOnCharacterId', null) == data.characterId
          && data.cursed == (after.cardKind == 'cursed')
          && get(cardPath(after.cardId)).data.hasUseEffect == true
          && get(characterPath(data.characterId)).data.uid == data.uid;
      }

      // A kept use created now, of a card or True Word whose "Kullanınca efekt bırakır" is on.
      function followsKeptUse(data) {
        let use = getAfter(usePath(data.sourceId)).data;
        return createdNow(usePath(data.sourceId))
          && use.by == request.auth.uid
          && use.get('usedOnCharacterId', null) == data.characterId
          && (data.source == 'word') == (use.cardKind == 'trueWord')
          && data.cursed == (use.cardKind == 'cursed')
          && get(cardPath(use.cardId)).data.hasUseEffect == true
          && get(characterPath(data.characterId)).data.uid == data.uid;
      }
    }

    // The player note: the whole table reads it; the player writes their own, and the DM anyone's.
    match /playerNotes/{uid} {
      allow read: if isMember();
      allow create, update: if validNoteDoc(uid) && (isSelf(uid) || isDm());
      allow delete: if false;
    }

    // The DM note: only the DM reads and writes it, the note about the DM included. No player ever reads one.
    match /dmNotes/{uid} {
      allow read: if isDm();
      allow create, update: if validNoteDoc(uid) && isDm();
      allow delete: if false;
    }

    // The dice styles (DICE_STYLES in src/features/dice/schema.ts).
    function diceStyles() {
      return ['galaxy', 'gemstone', 'glass', 'iron', 'nebula', 'sunrise', 'sunset', 'walnut'];
    }

    // The fields of a roll's content (design D4 of dice-channel), in a public roll and in a hidden roll's DM record.
    function rollKeys() {
      return ['by', 'at', 'hidden', 'style', 'mode', 'modifier', 'note', 'dice', 'motion', 'sim'];
    }

    // The fields a roll's content may hold besides rollKeys(): the fixed number as written, when it is a sum (design
    // D1-D2 of dice-sum-modifier-and-nat-marks). Rolls from before it, and the initiative tracker's, have none.
    function rollOptionalKeys() {
      return ['modifierSum'];
    }

    // Each die type with the faces it can show, as `<type>:<face>` (DIE_MAX in src/features/dice/formula.ts): d4 to
    // d20 from 1 to their size, and the d100 tens die from 0 to 90 in tens.
    function dieFaces() {
      return 'd4:[1-4]|d6:[1-6]|d8:[1-8]|d10:([1-9]|10)|d12:([1-9]|1[0-2])|d20:([1-9]|1[0-9]|20)|d100:([1-9]?0)';
    }

    // The die at index `i`, or true past the list's end. A die is `{t, v}` with a face its die can show, and a d100
    // tens die is followed by its d10. Rules have no loops, so validRoll calls this per index. The check is one
    // pattern per die: twelve dice must stay well inside the rules' 1000 expressions per request.
    function dieAt(dice, i) {
      return i >= dice.size() || validDie(dice, i, dice[i]);
    }

    function validDie(dice, i, die) {
      return die.keys().hasOnly(['t', 'v'])
        && die.v is int
        && (die.t + ':' + string(die.v)).matches(dieFaces())
        && (die.t != 'd100' || dice[i + 1].t == 'd10');
    }

    // A roll's content (spec: dice-rolls, "Roll records are checked"): 1 to 12 physical dice, each valid; advantage
    // or disadvantage only with exactly two d20; a fixed number from -99 to 99, and its written sum, when present, as
    // 2 to 8 numbers from 0 to 99 joined by + and - (MODIFIER_TEXT_MAX in src/features/dice/formula.ts); a note of at
    // most 80 characters; one of the styles; and the motion as a bounded string, which the client decodes leniently
    // (design D4). The client, not the rules, checks that the written sum adds up to the fixed number, and shows the
    // fixed number alone when it does not (design D2 of dice-sum-modifier-and-nat-marks).
    function validRoll(data) {
      return data.style in diceStyles()
        && data.mode in ['normal', 'advantage', 'disadvantage']
        && data.modifier is int
        && data.modifier >= -99
        && data.modifier <= 99
        && (!('modifierSum' in data)
          || (data.modifierSum is string
            && data.modifierSum.size() <= 24
            && data.modifierSum.matches('-?[0-9]{1,2}([+-][0-9]{1,2}){1,7}')))
        && data.note is string
        && data.note.size() <= 80
        && data.motion is string
        && data.motion.size() <= 1400
        && data.sim is int
        && data.dice is list
        && data.dice.size() >= 1
        && data.dice.size() <= 12
        && dieAt(data.dice, 0) && dieAt(data.dice, 1) && dieAt(data.dice, 2) && dieAt(data.dice, 3)
        && dieAt(data.dice, 4) && dieAt(data.dice, 5) && dieAt(data.dice, 6) && dieAt(data.dice, 7)
        && dieAt(data.dice, 8) && dieAt(data.dice, 9) && dieAt(data.dice, 10) && dieAt(data.dice, 11)
        && (data.mode == 'normal'
          || (data.dice.size() == 2 && data.dice[0].t == 'd20' && data.dice[1].t == 'd20'));
    }

    // Dice rolls (spec: dice-rolls, "Roll records"). Everyone signed in reads every roll. A user creates only their
    // own, at the server time, and nobody changes or deletes one. A public roll holds its whole content. A hidden roll
    // is the DM's only: its public record holds who and when, and its content goes to `dmRolls` in the same batch.
    match /diceRolls/{rollId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && (publicRoll() || hiddenRoll());
      allow update, delete: if false;

      function publicRoll() {
        let data = request.resource.data;
        return data.keys().hasOnly(rollKeys().concat(rollOptionalKeys()))
          && data.keys().hasAll(rollKeys())
          && data.hidden == false
          && validRoll(data);
      }

      function hiddenRoll() {
        let data = request.resource.data;
        return data.keys().hasOnly(['by', 'at', 'hidden'])
          && data.keys().hasAll(['by', 'at', 'hidden'])
          && data.hidden == true
          && isDm()
          && createdNow(dmRollPath(rollId));
      }
    }

    // A hidden roll's content: only the DM reads one, and only the DM creates one, together with its hidden public
    // record under the same ID. Nobody changes or deletes one.
    match /dmRolls/{rollId} {
      allow read: if isDm();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(rollKeys().concat(rollOptionalKeys()))
        && request.resource.data.keys().hasAll(rollKeys())
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.hidden == true
        && validRoll(request.resource.data)
        && isDm()
        && createdNow(diceRollPath(rollId))
        && getAfter(diceRollPath(rollId)).data.hidden == true;
      allow update, delete: if false;
    }

    // The one combat (spec: initiative-tracker; design D1, D5-D7 of add-initiative-tracker). Everyone signed in reads
    // it. Only the DM opens it (only from idle, so there is one combat at a time), starts the fight, changes the order,
    // the turn and the round, and ends it. A player only moves the turn on by one place while the active combatant is
    // their own character. Keep in step with src/features/combat/schema.ts and api.ts.
    match /combat/main {
      allow read: if isMember();
      allow create: if isMember() && validCombat(request.resource.data) && opensCombat(null) && isDm();
      allow update: if isMember()
        && validCombat(request.resource.data)
        && ((isDm()
            && ((resource.data.phase == 'idle' && opensCombat(resource.data.changeId))
              || startsFight()
              || changesFight()
              || endsCombat()))
          || endsOwnTurn());
      allow delete: if false;

      function combatKeys() {
        return ['phase', 'combatId', 'order', 'turn', 'round', 'askedAt', 'turnAt', 'changeId'];
      }

      function validCombat(data) {
        return data.keys().hasOnly(combatKeys())
          && data.keys().hasAll(combatKeys())
          && data.phase in ['idle', 'gathering', 'running']
          && (data.combatId == null || (data.combatId is string && data.combatId.size() > 0))
          && data.order is list
          && data.order.size() <= 50
          && data.turn is int
          && data.turn >= 0
          && data.round is int
          && data.round >= 0
          && (data.askedAt == null || data.askedAt is timestamp)
          && (data.turnAt == null || data.turnAt is timestamp)
          && (data.changeId == null || data.changeId is string);
      }

      // "Modifier iste": a new combat, waiting for rolls, with its last change record kept.
      function opensCombat(changeIdBefore) {
        let next = request.resource.data;
        return next.phase == 'gathering'
          && next.combatId is string
          && next.order.size() == 0
          && next.turn == 0
          && next.round == 0
          && next.askedAt == request.time
          && next.turnAt == null
          && next.changeId == changeIdBefore;
      }

      // "Başlat": from gathering to round 1 with a fixed order, together with its start record.
      function startsFight() {
        let next = request.resource.data;
        return resource.data.phase == 'gathering'
          && next.phase == 'running'
          && next.combatId == resource.data.combatId
          && next.order.size() >= 1
          && next.turn == 0
          && next.round == 1
          && next.askedAt == resource.data.askedAt
          && next.turnAt == request.time
          && next.changeId is string
          && createdNow(combatChangePath(next.changeId))
          && getAfter(combatChangePath(next.changeId)).data.step == 'start';
      }

      // The DM's steps while the fight runs: the order, the turn and the round. The time changes with the turn.
      function changesFight() {
        let next = request.resource.data;
        return resource.data.phase == 'running'
          && next.phase == 'running'
          && onlyChanges(['order', 'turn', 'round', 'turnAt'])
          && next.round >= 1
          && (next.order.size() == 0 ? next.turn == 0 : next.turn < next.order.size())
          && (next.turnAt == resource.data.turnAt || next.turnAt == request.time);
      }

      // "Bitir" or "Vazgeç": back to idle; a started fight gets its end record.
      function endsCombat() {
        let next = request.resource.data;
        return resource.data.phase in ['gathering', 'running']
          && next.phase == 'idle'
          && next.combatId == null
          && next.order.size() == 0
          && next.turn == 0
          && next.round == 0
          && next.askedAt == null
          && next.turnAt == null
          && (resource.data.phase == 'gathering'
            ? next.changeId == resource.data.changeId
            : (next.changeId is string
              && createdNow(combatChangePath(next.changeId))
              && getAfter(combatChangePath(next.changeId)).data.step == 'end'));
      }

      // "Turumu bitirdim": exactly one place on, wrapping into the next round, by the active character's owner.
      function endsOwnTurn() {
        let next = request.resource.data;
        let before = resource.data;
        return before.phase == 'running'
          && onlyChanges(['turn', 'round', 'turnAt'])
          && next.turnAt == request.time
          && before.order.size() > 0
          && before.turn < before.order.size()
          && get(combatantPath(before.order[before.turn])).data.kind == 'character'
          && get(combatantPath(before.order[before.turn])).data.uid == request.auth.uid
          && ((next.turn == before.turn + 1 && next.turn < before.order.size() && next.round == before.round)
            || (before.turn == before.order.size() - 1 && next.turn == 0 && next.round == before.round + 1));
      }
    }

    // The combatants of the open combat (design D1, D3 of add-initiative-tracker). Everyone signed in reads them.
    // Only the DM adds and removes them: while gathering without a roll (an NPC may come with its DM record), and while
    // the fight runs only by hand. The roll of a character is written once, while gathering, by its owner or the DM,
    // together with the roll record that shows it. Only the DM marks an NPC as rolled, and clears a roll.
    match /combatants/{combatantId} {
      allow read: if isMember();
      allow create: if isMember()
        && validCombatant(request.resource.data)
        && joinsCombat(request.resource.data)
        && isDm();
      allow update: if isMember()
        && validCombatant(request.resource.data)
        && onlyChanges(['rolled', 'roll'])
        && get(combatPath()).data.phase == 'gathering'
        && get(combatPath()).data.combatId == resource.data.combatId
        && (rollsCharacter() || (isDm() && (marksNpcRolled() || clearsRoll())));
      allow delete: if isDm();

      function combatantKeys() {
        return ['combatId', 'kind', 'characterId', 'uid', 'name', 'seq', 'manual', 'rolled', 'roll'];
      }

      function validCombatant(data) {
        return data.keys().hasOnly(combatantKeys())
          && data.keys().hasAll(combatantKeys())
          && data.combatId is string
          && data.uid is string
          && data.seq is int
          && data.seq >= 0
          && data.manual is bool
          && data.rolled is bool
          && ((data.kind == 'character'
              && data.characterId is string
              && data.name == null
              && (data.roll == null || validCombatantRoll(data.roll)))
            || (data.kind == 'npc'
              && data.characterId == null
              && textOfSize(data.name, 44)
              && data.roll == null));
      }

      function validCombatantRoll(roll) {
        return roll is map
          && roll.keys().hasOnly(['rollId', 'die', 'modifier'])
          && roll.keys().hasAll(['rollId', 'die', 'modifier'])
          && roll.rollId is string
          && roll.die is int
          && roll.die >= 1
          && roll.die <= 20
          && validInitiativeModifier(roll.modifier);
      }

      // A new combatant of this combat: a stored character of its owner, or the DM's NPC. While gathering it has no
      // roll, and an NPC may come rolled with its DM record; while the fight runs it is added by hand.
      function joinsCombat(data) {
        let combat = getAfter(combatPath()).data;
        return data.combatId == combat.combatId
          && (data.kind == 'npc'
            ? data.uid == request.auth.uid
            : (exists(characterPath(data.characterId))
              && get(characterPath(data.characterId)).data.uid == data.uid))
          && data.roll == null
          && ((combat.phase == 'gathering'
              && data.manual == false
              && (data.rolled == false
                || (data.kind == 'npc' && existsAfter(dmCombatantPath(combatantId)))))
            || (combat.phase == 'running' && data.manual == true && data.rolled == false));
      }

      // A character's roll (design D3): its owner or the DM, once, matching the roll record of this same request.
      function rollsCharacter() {
        return resource.data.kind == 'character'
          && resource.data.roll == null
          && (resource.data.uid == request.auth.uid || isDm())
          && request.resource.data.rolled == true
          && request.resource.data.roll != null
          && shownBy(request.resource.data.roll);
      }

      function shownBy(roll) {
        let record = getAfter(diceRollPath(roll.rollId)).data;
        return createdNow(diceRollPath(roll.rollId))
          && record.by == request.auth.uid
          && record.hidden == false
          && record.mode == 'normal'
          && record.dice.size() == 1
          && record.dice[0].t == 'd20'
          && record.dice[0].v == roll.die
          && record.modifier == roll.modifier;
      }

      function marksNpcRolled() {
        return resource.data.kind == 'npc'
          && resource.data.rolled == false
          && request.resource.data.rolled == true;
      }

      // "Yeniden attır".
      function clearsRoll() {
        return resource.data.rolled == true
          && request.resource.data.rolled == false
          && request.resource.data.roll == null;
      }
    }

    // An NPC's roll and modifier (design D1, D4 of add-initiative-tracker): only the DM reads or writes them.
    match /dmCombatants/{combatantId} {
      allow read, delete: if isDm();
      allow create, update: if isDm()
        && request.resource.data.keys().hasOnly(['combatId', 'rollId', 'die', 'modifier'])
        && request.resource.data.keys().hasAll(['combatId', 'rollId', 'die', 'modifier'])
        && request.resource.data.combatId is string
        && request.resource.data.rollId is string
        && request.resource.data.die is int
        && request.resource.data.die >= 1
        && request.resource.data.die <= 20
        && validInitiativeModifier(request.resource.data.modifier);
    }

    // Fight records for the log (spec: activity-log, "Combat change records"; design D7 of add-initiative-tracker): one
    // when a fight starts, with its combatants, and one when it ends, with its round. Everyone signed in reads them.
    // Only the DM creates one, together with the combat change it records. A record never changes and is never deleted.
    match /combatChanges/{changeId} {
      allow read: if isMember();
      allow create: if isMember() && validCombatChange() && isDm();
      allow update, delete: if false;

      function validCombatChange() {
        let data = request.resource.data;
        let before = get(combatPath()).data;
        let after = getAfter(combatPath()).data;
        return data.keys().hasOnly(['by', 'at', 'step', 'count'])
          && data.keys().hasAll(['by', 'at', 'step', 'count'])
          && data.by == request.auth.uid
          && data.at == request.time
          && data.count is int
          && exists(combatPath())
          && after.changeId == changeId
          && ((data.step == 'start'
              && before.phase == 'gathering'
              && after.phase == 'running'
              && data.count == after.order.size())
            || (data.step == 'end'
              && before.phase == 'running'
              && after.phase == 'idle'
              && data.count == before.round));
      }
    }

    // Closed catch-all: anything no rule grants is denied, for signed-in and signed-out users alike.
    // A request is allowed if ANY matching rule allows it, so this never overrides a deliberately opened path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
