{
  "name": "legend-cards",
  "version": "1.0.0",
  "private": true,
  "description": "Legend Card Manager: a real-time tracker for a DM's side card system in a D&D 5e group.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n emu,web -c yellow,cyan \"npm:emulators\" \"npm:dev:web\"",
    "dev:web": "vite",
    "emulators": "node -e \"require('fs').mkdirSync('.firebase-emulator-data',{recursive:true})\" && firebase emulators:start --only auth,firestore,storage --project demo-legend-cards --import .firebase-emulator-data --export-on-exit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-legend-cards \"vitest run --project emulator\"",
    "set-role": "node scripts/set-role.ts",
    "allow-email": "node scripts/allow-email.ts",
    "import-sets": "node scripts/import-sets.ts",
    "import-cards": "node scripts/import-cards.ts",
    "import-true-words": "node scripts/import-true-words.ts",
    "build-art": "node scripts/build-art.ts",
    "import-pictures": "node scripts/import-pictures.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-three/fiber": "9.8.2",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "three": "0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "csv-parse": "^7.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
