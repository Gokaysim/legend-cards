# Every setting the app reads. Vite exposes only variables that start with VITE_.
#
# Development uses .env.development (committed, demo values, emulators on).
# A real Firebase project goes in .env.production.local (git-ignored).
# Firebase web config values are public identifiers, not secrets: security comes from firestore.rules.

# Web API key of the Firebase web app (Firebase console -> Project settings -> Your apps).
VITE_FIREBASE_API_KEY=

# Auth domain, usually <project-id>.firebaseapp.com.
VITE_FIREBASE_AUTH_DOMAIN=

# Firebase project ID. Development uses demo-legend-cards, which never reaches a real project.
VITE_FIREBASE_PROJECT_ID=

# App ID of the Firebase web app, for example 1:1234567890:web:abc123.
VITE_FIREBASE_APP_ID=

# Cloud Storage bucket of the card and True Word pictures, usually <project-id>.firebasestorage.app
# (Firebase console -> Storage). Development uses demo-legend-cards.firebasestorage.app.
VITE_FIREBASE_STORAGE_BUCKET=

# "true" connects Auth, Firestore and Storage to the local emulators (127.0.0.1:9099, 127.0.0.1:8080 and
# 127.0.0.1:9199).
# Leave it "false" (or unset) for a real project.
VITE_USE_FIREBASE_EMULATORS=false
